grammar;

use crate::front::ast::{
    Item,
    VarDecl,
    Expr,
    Stmt,
    Function,
    FunctionParam,
    FunctionBuild,
    FunctionBuildDirective,
    FbCondition,
    ClosedLabelSet,
    AtomDef,
    AssignStmt,
    Struct,
    StructField,
    LabelName,
    MatchPat,
    MatchArm,
    MatchArmBody,
    ExprMatchArm,
    parse_dynamic_label_template,
};
use crate::front::ident::{self, IdentCategory, ParsedIdentifier};
use crate::front::parse_error::ParserUserError;
use crate::front::span::{Span, Spanned};
use crate::front::lexer::Token;
use crate::front::type_helper::{Type, TypeAnnot};
use crate::front::type_surface;
use lalrpop_util::ParseError;

extern {
    type Location = usize;
    type Error = ParserUserError;

    enum Token {
        LBrace => Token::LBrace,
        RBrace => Token::RBrace,
        LBracket => Token::LBracket,
        RBracket => Token::RBracket,
        LParen => Token::LParen,
        RParen => Token::RParen,
        Plus   => Token::Plus,
        PlusPlus => Token::PlusPlus,
        Star   => Token::Star,
        Minus  => Token::Minus,
        MinusMinus => Token::MinusMinus,
        Div    => Token::Div,
        Mod    => Token::Mod,
        Assign => Token::Assign,
        EqEq   => Token::EqEq,
        Neq    => Token::Neq,
        Lt     => Token::Lt,
        LtColon => Token::LtColon,
        Gt     => Token::Gt,
        GtGt   => Token::GtGt,
        Question => Token::Question,
        QuestionLParen => Token::QuestionLParen,
        Match => Token::Match,
        Case => Token::Case,
        Break => Token::Break,
        FatArrow => Token::FatArrow,
        Le     => Token::Le,
        Ge     => Token::Ge,
        Dot    => Token::Dot,
        DotDot => Token::DotDot,
        Semi   => Token::Semi,
        StrLiteral => Token::StrLiteral(<String>),
        If     => Token::If,
        Else   => Token::Else,
        While  => Token::While,
        IDENT  => Token::Ident(<String>),
        ESCAPED_IDENT => Token::EscapedIdent(<String>),
        MACRO  => Token::Macro(<String>),
        NUM    => Token::Num(<i64>),
        FLOAT  => Token::Float(<f64>),
        TRUE  => Token::Bool(true),
        FALSE => Token::Bool(false),
        Comma  => Token::Comma,
        Colon  => Token::Colon,
        QUALIFIED_ATOM => Token::QualifiedAtom(<String>),
        Function => Token::Function,
        Return => Token::Return,
        Use => Token::Use,
        FunctionBuild => Token::FunctionBuild,
        Private => Token::Private,
        PREPROCESSOR => Token::Preprocessor(<String>),
        Import => Token::Import,
        Package => Token::Package,
        Var => Token::Var,
        Public => Token::Public,
        Struct => Token::Struct,
        Ambi => Token::Ambi,
        InstanceCreate => Token::InstanceCreate,
        Destroy => Token::Destroy,
        Exist => Token::Exist,
        Unsafe => Token::Unsafe,
        Defer => Token::Defer,
        Init => Token::Init,
        Source => Token::Source,
        Params => Token::Params,
        ReturnTypeKw => Token::ReturnTypeKw,
        Visibility => Token::Visibility,
        TypeParam => Token::TypeParam,
        When => Token::When,
        Is => Token::Is,
        NeqKw => Token::NeqKw,
        And => Token::And,
        Or => Token::Or,
        Not => Token::Not,

        TypeBool => Token::TypeBool,
        TypeStr => Token::TypeStr,
        TypeUnit => Token::TypeUnit,
        TypeLabel => Token::TypeLabel,

        TypeI8 => Token::TypeI8,
        TypeU8 => Token::TypeU8,
        TypeI16 => Token::TypeI16,
        TypeU16 => Token::TypeU16,
        TypeI32 => Token::TypeI32,
        TypeU32 => Token::TypeU32,
        TypeI64 => Token::TypeI64,
        TypeU64 => Token::TypeU64,

        TypeF16 => Token::TypeF16,
        TypeF32 => Token::TypeF32,
        TypeF64 => Token::TypeF64,
    }
}

pub Start: Vec<Item> =
    <items:ItemNode*> => items;

ItemNode: Item = {
    FunctionDef,
    PubFunctionDef,
    FunctionBuildFnDef,
    FunctionBuildDef,
    PubFunctionBuildDef,
    FunctionBuildSourceDef,
    PreprocessorItem,
    <start:@L> <v:GlobalVarDecl> <end:@R> => Item::VarItem(v),
    <start:@L> <i:ImportDirective> <end:@R> => Item::Import(i),
    <start:@L> <p:PackageDirective> <end:@R> => Item::Package(p),
    <start:@L> <s:StructDef> <end:@R> => Item::StructItem(s),
    LabelAtomDef,
    ClosedLabelSetDef,
};

PreprocessorItem: Item = {
    <start:@L> <p:PREPROCESSOR> <end:@R> => Item::Preprocessor(p)
};

FunctionBuildSourceDef: Item =
    <start:@L> FunctionBuild Source <name:ModName> Semi <end:@R> =>
        Item::FunctionBuildSource { target: name, span: Span::new(start, end) };

ImportDirective: String = {
    Import <id:ModName> Semi => id,
};

PackageDirective: String = {
    Package <id:ModName> Semi => id,
};

LabelAtomDef: Item =
    <start:@L> <is_pub:PublicKw> TypeLabel Colon <name:OpenLabelName> Semi <end:@R> => Item::AtomItem(AtomDef {
        ident: name,
        is_public: is_pub,
        span: Span::new(start, end),
    });

ClosedLabelSetDef: Item =
    <start:@L> <is_pub:PublicKw> TypeLabel <name:PascalName> LBrace <members:ClosedLabelMemberList> RBrace <end:@R> => Item::ClosedLabelSetItem(ClosedLabelSet {
        ident: name,
        members,
        is_public: is_pub,
        span: Span::new(start, end),
    });

ClosedLabelMemberList: Vec<String> = {
    <first:ClosedMemberName> <rest:MoreClosedLabelMembers> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

MoreClosedLabelMembers: Vec<String> = {
    => vec![],
    Comma <tail:ClosedLabelMemberTail> => tail,
};

ClosedLabelMemberTail: Vec<String> = {
    => vec![],
    <v:ClosedMemberName> <rest:MoreClosedLabelMembers> => {
        let mut v = vec![v];
        v.extend(rest);
        v
    }
};

StructDef: Struct =
    <start:@L> <is_pub:PublicKw> Struct <name:PascalName> LBrace <fields:StructFieldList> RBrace <end:@R> => {
        Struct {
            ident: name,
            fields,
            is_public: is_pub,
            _methods: vec![],
            span: Span::new(start, end),
        }
};

StructFieldList: Vec<StructField> = {
    => vec![],
    <first:StructFieldNode> <rest:(Comma <StructFieldNode>)*> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

StructFieldNode: StructField = {
    <start:@L> <id:FieldName> <ty:FieldType?> <def:FieldDefault?> <end:@R> => StructField {
        ident: id,
        ty,
        default_value: def,
        span: Span::new(start, end),
    }
};

FieldType: Type = {
    GtGt <t:Type> => t,
};

FieldDefault: Spanned<Expr> = {
    Assign <e:Expr> => e,
};

FnKw: () = <tok:Function> => ();

PublicKw: bool = {
    Public => true,
    => false,
};

FunctionDef: Item =
   <start:@L> FnKw <name:FnName> LParen <params:ParamList> RParen <ret:ReturnType> <body:Block> <end:@R> => {
        Item::FunctionItem(Function {
            ident: name,
            params,
            ret_ty: ret,
            blk: body,
            is_public: false,
            build_ref: None,
            build_ref_span: Span::DUMMY,
            span: Span::new(start, end),
        })
    };

PubFunctionDef: Item =
   <start:@L> Public FnKw <name:FnName> LParen <params:ParamList> RParen <ret:ReturnType> <body:Block> <end:@R> => {
        Item::FunctionItem(Function {
            ident: name,
            params,
            ret_ty: ret,
            blk: body,
            is_public: true,
            build_ref: None,
            build_ref_span: Span::DUMMY,
            span: Span::new(start, end),
        })
    };

FunctionBuildFnDef: Item =
   <start:@L> FnKw <name:FnName> Use <build:PascalName> <body:Block> <end:@R> => {
        Item::FunctionItem(Function {
            ident: name,
            params: vec![],
            ret_ty: None,
            blk: body,
            is_public: false,
            build_ref: Some(build),
            build_ref_span: Span::new(start, end),
            span: Span::new(start, end),
        })
    };

FunctionBuildDef: Item =
    <start:@L> FunctionBuild <name:PascalName> LBrace <directives:FbDirectiveList> RBrace <end:@R> => {
        Item::FunctionBuildItem(FunctionBuild {
            ident: name,
            directives,
            is_public: false,
            span: Span::new(start, end),
        })
    };

PubFunctionBuildDef: Item =
    <start:@L> Public FunctionBuild <name:PascalName> LBrace <directives:FbDirectiveList> RBrace <end:@R> => {
        Item::FunctionBuildItem(FunctionBuild {
            ident: name,
            directives,
            is_public: true,
            span: Span::new(start, end),
        })
    };

FbDirectiveList: Vec<FunctionBuildDirective> = {
    => vec![],
    <mut ds:FbDirectiveList> <d:FbDirective> => { ds.push(d); ds }
};

FbDirective: FunctionBuildDirective = {
    FbParamsDirective,
    FbRetDirective,
    FbVisDirective,
    FbTypeParamDirective,
    FbWhenDirective,
    <start:@L> <m:MacroName> LParen <_args:ArgList> RParen Semi <end:@R> =>? {
        Err(type_surface::syn(
            7,
            Span::new(start, end),
            format!("invalid FunctionBuild directive @{}", m),
            Some("FunctionBuild entries are params / return_type / visibility / type_param / when".to_string()),
        ))
    },
};

FbParamsDirective: FunctionBuildDirective =
    <start:@L> Params LParen <params:ParamList> RParen Semi <end:@R> =>
        FunctionBuildDirective::Params { params, span: Span::new(start, end) };

FbRetDirective: FunctionBuildDirective =
    <start:@L> ReturnTypeKw LParen <t:Type> RParen Semi <end:@R> =>
        FunctionBuildDirective::ReturnType { ty: t, span: Span::new(start, end) };

FbVisDirective: FunctionBuildDirective =
    <start:@L> Visibility LParen <is_public:FbVisibilityValue> RParen Semi <end:@R> =>
        FunctionBuildDirective::Visibility { is_public, span: Span::new(start, end) };

FbTypeParamDirective: FunctionBuildDirective =
    <start:@L> TypeParam <id:PascalName> Semi <end:@R> =>
        FunctionBuildDirective::TypeParam { ident: id, span: Span::new(start, end) };

FbWhenDirective: FunctionBuildDirective =
    <start:@L> When <cond:FbCond> LBrace ReturnTypeKw LParen <t:Type> RParen Semi RBrace <end:@R> =>
        FunctionBuildDirective::When { condition: cond, ret_ty: t, span: Span::new(start, end) };

FbVisibilityValue: bool = {
    Public => true,
    Private => false,
};

FbCond: FbCondition = {
    <l:FbCond> Or <r:FbCondAnd> => FbCondition::Or { lhs: Box::new(l), rhs: Box::new(r) },
    <c:FbCondAnd> => c,
};

FbCondAnd: FbCondition = {
    <l:FbCondAnd> And <r:FbCondCmp> => FbCondition::And { lhs: Box::new(l), rhs: Box::new(r) },
    <c:FbCondCmp> => c,
};

FbCondCmp: FbCondition = {
    <l:FbCondNot> Is <r:FbCondNot> => FbCondition::Is { lhs: Box::new(l), rhs: Box::new(r) },
    <l:FbCondNot> NeqKw <r:FbCondNot> => FbCondition::Neq { lhs: Box::new(l), rhs: Box::new(r) },
    <c:FbCondNot> => c,
};

FbCondNot: FbCondition = {
    Not <c:FbCondNot> => FbCondition::Not { inner: Box::new(c) },
    <c:FbCondAtom> => c,
};

FbCondAtom: FbCondition = {
    TRUE => FbCondition::Bool(true),
    FALSE => FbCondition::Bool(false),
    LParen <c:FbCond> RParen => c,
    <t:Type> => FbCondition::Type(t),
};

ParamList: Vec<FunctionParam> = {
    => vec![],
    <first:FunctionParamNode> <rest:(Comma <FunctionParamNode>)*> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

FunctionParamNode: FunctionParam = {
    <start:@L> <id:LocalName> GtGt <t:TypeAnnot> <end:@R> => FunctionParam { ident: id, ty: Some(t), span: Span::new(start, end) },
    <start:@L> <id:LocalName> <end:@R> => FunctionParam { ident: id, ty: None, span: Span::new(start, end) },
};

TypeAnnot: TypeAnnot = {
    Ambi <t:Type> => TypeAnnot { ty: t, ambi: true },
    <t:Type> => TypeAnnot { ty: t, ambi: false },
};

Type: Type = {
    TypeBool => Type::Bool,
    TypeStr => Type::Str,
    TypeUnit => Type::Unit,
    <start:@L> TypeLabel <end:@R> =>? Err(type_surface::reject_label_keyword(Span::new(start, end))),

    <start:@L> Colon <id:OpenLabelName> <end:@R> => Type::Atom(id),

    TypeI8 => Type::TypeI8,
    TypeU8 => Type::TypeU8,
    TypeI16 => Type::TypeI16,
    TypeU16 => Type::TypeU16,
    TypeI32 => Type::TypeI32,
    TypeU32 => Type::TypeU32,
    TypeI64 => Type::TypeI64,
    TypeU64 => Type::TypeU64,

    TypeF16 => Type::TypeF16,
    TypeF32 => Type::TypeF32,
    TypeF64 => Type::TypeF64,

    <start:@L> <id:Ident> LParen <args:TypeArgList> RParen <end:@R> =>? {
        let _ = start;
        let _ = end;
        type_surface::finish_type(id, args)
    },
    <id:Ident> =>? type_surface::finish_type(id, vec![]),
};

TypeArgList: Vec<Type> = {
    => vec![],
    <first:Type> <rest:(Comma <Type>)*> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
};

ReturnType: Option<Type> = {
    GtGt <t:TypeAnnot> => Some(t.ty),
    => None,
};

ArgList: Vec<Spanned<Expr>> = {
    => vec![],
    <e:Expr> => vec![e],
    <first:Expr> Comma <rest:ArgListTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

ArgListTail: Vec<Spanned<Expr>> = {
    <e:Expr> => vec![e],
    <first:Expr> Comma <rest:ArgListTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

Block: Vec<Spanned<Stmt>> =
    LBrace <stmts:Stmts> RBrace => stmts;

Stmts: Vec<Spanned<Stmt>> = {
    => vec![],
    <mut stmts:Stmts> <s:Stmt> => { stmts.push(s); stmts }
};

Stmt: Spanned<Stmt> = {
    <start:@L> <v:LocalVarDecl> <end:@R> => Spanned::new(Stmt::Var(v), Span::new(start, end)),
    <start:@L> <e:ExprNoMatch> <tail:StmtTail> <end:@R> =>? {
        match tail {
            None => Ok(Spanned::new(Stmt::Expr(e), Span::new(start, end))),
            Some(val) => {
                if let Expr::Var(id) = e.node {
                    Ok(Spanned::new(Stmt::Assign(AssignStmt { name: id, expr: val, span: Span::new(start, end) }), Span::new(start, end)))
                } else if let Expr::Index(collection, index) = e.node {
                    Ok(Spanned::new(Stmt::IndexAssign { collection: *collection, index: *index, expr: val, span: Span::new(start, end) }, Span::new(start, end)))
                } else {
                    Err(type_surface::syn(
                        5,
                        Span::new(start, end),
                        "Invalid assignment target",
                        None,
                    ))
                }
            }
        }
    },
    IfStmt,
    MatchStmt,
    <start:@L> While <c:Expr> <body:Block> <end:@R> =>
        Spanned::new(Stmt::While {
            cond: c,
            body: body,
        }, Span::new(start, end)),
    <start:@L> Unsafe <body:Block> <end:@R> =>
        Spanned::new(Stmt::Unsafe {
            body: body,
            span: Span::new(start, end),
        }, Span::new(start, end)),
    <start:@L> Defer <e:Expr> Semi <end:@R> =>
        Spanned::new(Stmt::Defer {
            expr: e,
            span: Span::new(start, end),
        }, Span::new(start, end)),
    <start:@L> Return <e:Expr> Semi <end:@R> => Spanned::new(Stmt::Return(Some(e)), Span::new(start, end)),
    <start:@L> Return Semi <end:@R> => Spanned::new(Stmt::Return(None), Span::new(start, end)),
}

#[inline]
IfStmt: Spanned<Stmt> = {
    <start:@L> If <c:Expr> <then:Block> <end:@R> => Spanned::new(Stmt::If {
        cond: c,
        then_blk: then,
        else_blk: None,
    }, Span::new(start, end)),
    <start:@L> If <c:Expr> <then:Block> Else <else_blk:Block> <end:@R> => Spanned::new(Stmt::If {
        cond: c,
        then_blk: then,
        else_blk: Some(else_blk),
    }, Span::new(start, end)),
};

MatchStmt: Spanned<Stmt> = {
    <start:@L> Match <e:Expr> QuestionLParen Var <bind:LocalName> RParen
        LBrace <arms:MatchArmsBind> RBrace <end:@R>
      => Spanned::new(Stmt::Match {
          scrutinee: e,
          bind: Some(bind),
          arms,
          span: Span::new(start, end),
      }, Span::new(start, end)),

    <start:@L> Match <e:Expr> LBrace <arms:MatchArmsBlock> RBrace <end:@R>
      => Spanned::new(Stmt::Match {
          scrutinee: e,
          bind: None,
          arms,
          span: Span::new(start, end),
      }, Span::new(start, end)),
};

MatchArmsBind: Vec<MatchArm> = {
    <a:MatchArmBind> => vec![a],
    <a:MatchArmBind> <rest:MatchArmsBind> => {
        let mut v = vec![a];
        v.extend(rest);
        v
    }
};

MatchArmBind: MatchArm = {
    <start:@L> Case <pat:MatchPatNode> FatArrow <e:Expr> Break Semi <end:@R> => MatchArm {
        pat,
        body: MatchArmBody::ExprBreak(e),
        span: Span::new(start, end),
    },
};

MatchArmsBlock: Vec<MatchArm> = {
    <a:MatchArmBlock> => vec![a],
    <a:MatchArmBlock> <rest:MatchArmsBlock> => {
        let mut v = vec![a];
        v.extend(rest);
        v
    }
};

MatchArmBlock: MatchArm = {
    <start:@L> Case <pat:MatchPatNode> FatArrow <body:Block> <end:@R> => MatchArm {
        pat,
        body: MatchArmBody::Block(body),
        span: Span::new(start, end),
    },
};

MatchArmsExpr: Vec<ExprMatchArm> = {
    <a:MatchArmExpr> => vec![a],
    <a:MatchArmExpr> <rest:MatchArmsExpr> => {
        let mut v = vec![a];
        v.extend(rest);
        v
    }
};

MatchArmExpr: ExprMatchArm = {
    <start:@L> Case <pat:MatchPatNode> FatArrow <e:Expr> <end:@R> => ExprMatchArm {
        pat,
        value: e,
        span: Span::new(start, end),
    },
};

QualifiedAtomName: LabelName = {
    <start:@L> <name:QUALIFIED_ATOM> <end:@R> =>? {
        ident::validate_static_label(&name, Span::new(start, end)).map(LabelName::Static)
    }
};

MatchPatNode: MatchPat = {
    <q:QualifiedAtomName> => MatchPat::Name(q),
    Colon <id:OpenLabelName> => MatchPat::Name(LabelName::Static(id)),
    LBrace Colon <id:OpenLabelName> Comma <binder:MatchBinder> RBrace =>
        MatchPat::LabelPayload { name: LabelName::Static(id), binder },
    <id:Ident> =>? {
        if id.name == "_" && !id.escaped {
            Ok(MatchPat::Wildcard)
        } else {
            Err(type_surface::syn(
                6,
                id.span,
                "match pattern must be :name, {:name, binder}, or _",
                None,
            ))
        }
    },
};

MatchBinder: String = {
    <id:Ident> =>? {
        if id.name == "_" && !id.escaped {
            Ok("_".to_string())
        } else {
            ident::finish(id, IdentCategory::Local)
        }
    }
};

StmtTail: Option<Spanned<Expr>> = {
    Semi => None,
    Assign <e:AssignExpr> Semi => Some(e),
};

AssignExpr: Spanned<Expr> = {
    <start:@L> <id:LocalName> Assign <e:AssignExpr> <end:@R> => Spanned::new(Expr::Assign(id, Box::new(e)), Span::new(start, end)),
    <e:Expr> => e,
};

GlobalVarDecl: VarDecl = {
 <start:@L> Var <id:GlobalName> Assign <e:Expr> Semi <end:@R> => VarDecl { ident: id, expr: Some(e), span: Span::new(start, end) },
 <start:@L> Var <id:GlobalName> Semi <end:@R> => VarDecl { ident: id, expr: None, span: Span::new(start, end) },
};

LocalVarDecl: VarDecl = {
 <start:@L> Var <id:LocalName> Assign <e:Expr> Semi <end:@R> => VarDecl { ident: id, expr: Some(e), span: Span::new(start, end) },
 <start:@L> Var <id:LocalName> Semi <end:@R> => VarDecl { ident: id, expr: None, span: Span::new(start, end) },
};

Ident: ParsedIdentifier = {
    <start:@L> <name:IDENT> <end:@R> => ParsedIdentifier { name, escaped: false, span: Span::new(start, end) },
    <start:@L> <name:ESCAPED_IDENT> <end:@R> => ParsedIdentifier { name, escaped: true, span: Span::new(start, end) },
};

FnName: String = <id:Ident> =>? ident::finish(id, IdentCategory::Function);
ModName: String = <id:Ident> =>? ident::finish(id, IdentCategory::Module);
GlobalName: String = <id:Ident> =>? ident::finish(id, IdentCategory::GlobalVar);
LocalName: String = <id:Ident> =>? ident::finish(id, IdentCategory::Local);
FieldName: String = <id:Ident> =>? ident::finish(id, IdentCategory::Field);
PascalName: String = <id:Ident> =>? ident::finish(id, IdentCategory::PascalType);
OpenLabelName: String = <id:Ident> =>? ident::finish(id, IdentCategory::OpenLabel);
ClosedMemberName: String = <id:Ident> =>? ident::finish(id, IdentCategory::ClosedMember);
AttachName: String = <id:Ident> =>? ident::finish(id, IdentCategory::AttachSlot);

MacroName: String = {
    <start:@L> <name:MACRO> <end:@R> =>? ident::finish_macro(name, Span::new(start, end))
};

Num: i64 = <n:NUM> => n;
Float: f64 = <f:FLOAT> => f;
StringLiteral: String = <s:StrLiteral> => s;

BooleanLiteral: bool = {
    TRUE => true,
    FALSE => false,
};

Expr: Spanned<Expr> = {
    <e:ExprNoMatch> => e,
    <start:@L> Match <e:Expr> LBrace <arms:MatchArmsExpr> RBrace <end:@R> =>
        Spanned::new(Expr::Match {
            scrutinee: Box::new(e),
            arms,
        }, Span::new(start, end)),
};

ExprNoMatch: Spanned<Expr> = {
    <start:@L> <l:Comparison> DotDot <r:Comparison> <end:@R> => Spanned::new(Expr::Range(Box::new(l), Box::new(r)), Span::new(start, end)),
    <e:Comparison> => e,
}

Comparison: Spanned<Expr> = {
    <start:@L> <l:Comparison> EqEq <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Eq(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:Comparison> Neq <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Neq(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:Comparison> Lt <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Lt(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:Comparison> Gt <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Gt(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:Comparison> Le <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Le(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:Comparison> Ge <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Ge(Box::new(l), Box::new(r)), Span::new(start, end)),
    <a:AddAndMinus>                   => a,
}

AddAndMinus: Spanned<Expr> = {
    <start:@L> <l:AddAndMinus> Plus <r:MulAndDivAndMod> <end:@R> => Spanned::new(Expr::Add(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:AddAndMinus> Minus <r:MulAndDivAndMod> <end:@R> => Spanned::new(Expr::Minus(Box::new(l), Box::new(r)), Span::new(start, end)),
    <m:MulAndDivAndMod>              => m,
}

MulAndDivAndMod: Spanned<Expr> = {
    <start:@L> <l:MulAndDivAndMod> Star <r:Unary> <end:@R> => Spanned::new(Expr::Mul(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:MulAndDivAndMod> Div <r:Unary> <end:@R> => Spanned::new(Expr::Div(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:MulAndDivAndMod> Mod <r:Unary> <end:@R> => Spanned::new(Expr::Mod(Box::new(l), Box::new(r)), Span::new(start, end)),
    <u:Unary> => u,
}

Unary: Spanned<Expr> = {
    <start:@L> Minus <p:Unary> <end:@R> => Spanned::new(Expr::Neg(Box::new(p)), Span::new(start, end)),
    <p: Postfix> => p,
}

Postfix: Spanned<Expr> = {
    <start:@L> <base:Postfix> LBracket <index:Expr> RBracket <end:@R> => Spanned::new(Expr::Index(Box::new(base), Box::new(index)), Span::new(start, end)),
    <start:@L> <e:Postfix> PlusPlus <end:@R> => Spanned::new(Expr::Increment(Box::new(e)), Span::new(start, end)),
    <start:@L> <e:Postfix> MinusMinus <end:@R> => Spanned::new(Expr::Decrement(Box::new(e)), Span::new(start, end)),
    <start:@L> <base:Postfix> Dot <id:Ident> LParen RParen <end:@R> =>? {
        let field = ident::finish(id, IdentCategory::Function)?;
        if let Expr::Var(mod_name) = base.node {
            Ok(Spanned::new(Expr::ModuleAccess(mod_name, field, vec![]), Span::new(start, end)))
        } else {
            Err(type_surface::syn(
                6,
                Span::new(start, end),
                "method call on non-module expression is not supported",
                None,
            ))
        }
    },
    <start:@L> <base:Postfix> Dot <id:Ident> LParen <first:Expr> <rest:(Comma <Expr>)*> RParen <end:@R> =>? {
        let field = ident::finish(id, IdentCategory::Function)?;
        let mut args = vec![first];
        args.extend(rest);
        if let Expr::Var(mod_name) = base.node {
            Ok(Spanned::new(Expr::ModuleAccess(mod_name, field, args), Span::new(start, end)))
        } else {
            Err(type_surface::syn(
                6,
                Span::new(start, end),
                "method call on non-module expression is not supported",
                None,
            ))
        }
    },
    <start:@L> <base:Postfix> Dot <id:Ident> <end:@R> =>? {
        let field = ident::finish(id, IdentCategory::Field)?;
        if let Expr::Var(val) = base.node {
            Ok(Spanned::new(Expr::FieldAccess(Box::new(Spanned::new(Expr::Var(val), base.span)), field), Span::new(start, end)))
        } else {
            Ok(Spanned::new(Expr::FieldAccess(Box::new(base), field), Span::new(start, end)))
        }
    },
    <start:@L> <base:Postfix> Question <end:@R> => Spanned::new(Expr::Try(Box::new(base)), Span::new(start, end)),
    <f:Atom> => f,
}

Atom: Spanned<Expr> = {
    <start:@L> Init <name:PascalName> LBrace <fields:StructInitFields> RBrace <end:@R> =>
        Spanned::new(Expr::StructInit(name, fields), Span::new(start, end)),
    <start:@L> <m:MacroName> LParen RParen <end:@R> => Spanned::new(Expr::Macro(m, vec![]), Span::new(start, end)),
    <start:@L> <m:MacroName> LParen <first:Expr> <rest:(Comma <Expr>)*> RParen <end:@R> => {
        let mut args = vec![first];
        args.extend(rest);
        Spanned::new(Expr::Macro(m, args), Span::new(start, end))
    },
    <start:@L> InstanceCreate LParen <size:Expr> RParen <end:@R> =>
        Spanned::new(Expr::HeapAlloc(Box::new(size)), Span::new(start, end)),
    <start:@L> Destroy LParen <e:Expr> RParen <end:@R> =>
        Spanned::new(Expr::Destroy(Box::new(e)), Span::new(start, end)),
    <start:@L> Exist LParen <e:Expr> RParen <end:@R> =>
        Spanned::new(Expr::Exist(Box::new(e)), Span::new(start, end)),
    <start:@L> <id:Ident> LParen RParen <end:@R> =>? {
        let name = ident::finish(id, IdentCategory::Function)?;
        Ok(Spanned::new(Expr::Call(name, vec![]), Span::new(start, end)))
    },
    <start:@L> <id:Ident> LParen <first:Expr> <rest:(Comma <Expr>)*> RParen <end:@R> =>? {
        let name = ident::finish(id, IdentCategory::Function)?;
        let mut args = vec![first];
        args.extend(rest);
        Ok(Spanned::new(Expr::Call(name, args), Span::new(start, end)))
    },
    <start:@L> <q:QualifiedAtomName> <end:@R> => Spanned::new(Expr::Atom(q), Span::new(start, end)),
    <start:@L> Colon <id:OpenLabelName> <end:@R> => Spanned::new(Expr::Atom(LabelName::Static(id)), Span::new(start, end)),
    <start:@L> Colon <s:StringLiteral> <end:@R> =>? {
        match parse_dynamic_label_template(&s) {
            Ok(parts) => Ok(Spanned::new(Expr::Atom(LabelName::Dynamic(parts)), Span::new(start, end))),
            Err(msg) => Err(type_surface::syn(6, Span::new(start, end), msg, None)),
        }
    },
    <start:@L> LBrace Colon <id:OpenLabelName> Comma <payload:Expr> RBrace <end:@R> => Spanned::new(Expr::Label(LabelName::Static(id), Box::new(payload)), Span::new(start, end)),
    <start:@L> LBrace Colon <s:StringLiteral> Comma <payload:Expr> RBrace <end:@R> =>? {
        match parse_dynamic_label_template(&s) {
            Ok(parts) => Ok(Spanned::new(Expr::Label(LabelName::Dynamic(parts), Box::new(payload)), Span::new(start, end))),
            Err(msg) => Err(type_surface::syn(6, Span::new(start, end), msg, None)),
        }
    },
    <start:@L> LtColon <id:AttachName> <end:@R> => Spanned::new(Expr::AttachSlot(id), Span::new(start, end)),
    <start:@L> <id:Ident> <end:@R> =>? {
        let name = ident::finish(id, IdentCategory::Local)?;
        Ok(Spanned::new(Expr::Var(name), Span::new(start, end)))
    },
    <start:@L> <n:Num> <end:@R> => Spanned::new(Expr::Number(n), Span::new(start, end)),
    <start:@L> <f:Float> <end:@R> => Spanned::new(Expr::Float(f), Span::new(start, end)),
    <start:@L> <s:StringLiteral> <end:@R> => Spanned::new(Expr::Str(s), Span::new(start, end)),
    <start:@L> <b:BooleanLiteral> <end:@R> => Spanned::new(Expr::Bool(b), Span::new(start, end)),
    <start:@L> TypeI8 <end:@R> => Spanned::new(Expr::TypeI8, Span::new(start, end)),
    <start:@L> TypeU8 <end:@R> => Spanned::new(Expr::TypeU8, Span::new(start, end)),
    <start:@L> TypeI16 <end:@R> => Spanned::new(Expr::TypeI16, Span::new(start, end)),
    <start:@L> TypeU16 <end:@R> => Spanned::new(Expr::TypeU16, Span::new(start, end)),
    <start:@L> TypeI32 <end:@R> => Spanned::new(Expr::TypeI32, Span::new(start, end)),
    <start:@L> TypeU32 <end:@R> => Spanned::new(Expr::TypeU32, Span::new(start, end)),
    <start:@L> TypeI64 <end:@R> => Spanned::new(Expr::TypeI64, Span::new(start, end)),
    <start:@L> TypeU64 <end:@R> => Spanned::new(Expr::TypeU64, Span::new(start, end)),
    <start:@L> TypeF16 <end:@R> => Spanned::new(Expr::TypeF16, Span::new(start, end)),
    <start:@L> TypeF32 <end:@R> => Spanned::new(Expr::TypeF32, Span::new(start, end)),
    <start:@L> TypeF64 <end:@R> => Spanned::new(Expr::TypeF64, Span::new(start, end)),
    <start:@L> LParen RParen <end:@R> => Spanned::new(Expr::Unit(), Span::new(start, end)),
    <start:@L> LParen <e:Expr> RParen <end:@R> => Spanned::new(e.node, Span::new(start, end)),
    <start:@L> LBracket RBracket <end:@R> => Spanned::new(Expr::List(vec![]), Span::new(start, end)),
    <start:@L> LBracket <first:Expr> <rest:(Comma <Expr>)*> RBracket <end:@R> => {
        let mut v = vec![first];
        v.extend(rest);
        Spanned::new(Expr::List(v), Span::new(start, end))
    },
};

StructInitFields: Vec<(String, Spanned<Expr>)> = {
    => vec![],
    <f:StructInitField> => vec![f],
    <first:StructInitField> Comma <rest:StructInitFieldsTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

StructInitFieldsTail: Vec<(String, Spanned<Expr>)> = {
    => vec![],
    <f:StructInitField> => vec![f],
    <first:StructInitField> Comma <rest:StructInitFieldsTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

StructInitField: (String, Spanned<Expr>) = {
    <id:FieldName> Assign <e:Expr> => (id, e),
};
