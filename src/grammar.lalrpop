grammar;

use crate::front::ast::{
    Item, 
    VarDecl, 
    Expr, 
    Stmt, 
    Function, 
    FunctionParam, 
    Enum, 
    AssignStmt,
    Struct,
    StructField,
    Suffix,
};
use crate::front::span::{Span, Spanned};
use crate::front::lexer::Token;
use crate::front::type_helper::Type;
use lalrpop_util::ParseError;
use half::f16;

extern {
    type Location = usize;
    type Error = String;

    enum Token {
        LBrace => Token::LBrace,
        RBrace => Token::RBrace,
        LBracket => Token::LBracket,
        RBracket => Token::RBracket,
        LParen => Token::LParen,
        RParen => Token::RParen,
        Plus   => Token::Plus,
        PlusPlus => Token::PlusPlus,
        Star   => Token::Star,
        Minus  => Token::Minus,
        MinusMinus => Token::MinusMinus,
        Div    => Token::Div,
        Mod    => Token::Mod,
        Assign => Token::Assign,
        EqEq   => Token::EqEq,
        Neq    => Token::Neq,
        Lt     => Token::Lt,
        Gt     => Token::Gt,
        GtGt   => Token::GtGt,
        Question => Token::Question,
        Le     => Token::Le,
        Ge     => Token::Ge,
        Dot    => Token::Dot,
        DotDot => Token::DotDot,
        Semi   => Token::Semi,
        StrLiteral => Token::StrLiteral(String),
        If     => Token::If,
        Else   => Token::Else,
        While  => Token::While,
        IDENT  => Token::Ident(String),
        MACRO  => Token::Macro(String),
        NUM    => Token::Num(i64),
        FLOAT  => Token::Float(f64),
        TRUE  => Token::Bool(true),
        FALSE => Token::Bool(false),
        Comma  => Token::Comma,
        Function => Token::Function,
        Return => Token::Return,
        Preprocessor => Token::Preprocessor,
        Import => Token::Import,
        Package => Token::Package,
        Var => Token::Var,
        Public => Token::Public,
        Enum => Token::Enum,
        Struct => Token::Struct,

        // System types
        TypeInt => Token::TypeInt,
        TypeFloat => Token::TypeFloat,
        TypeBool => Token::TypeBool,
        TypeStr => Token::TypeStr,
        TypeUnit => Token::TypeUnit,

        TypeI8 => Token::TypeI8,
        TypeU8 => Token::TypeU8,
        TypeI16 => Token::TypeI16,
        TypeU16 => Token::TypeU16,
        TypeI32 => Token::TypeI32,
        TypeU32 => Token::TypeU32,
        TypeI64 => Token::TypeI64,
        TypeU64 => Token::TypeU64,

        TypeF16 => Token::TypeF16,
        TypeF32 => Token::TypeF32,
        TypeF64 => Token::TypeF64,
    }
}

pub Start: Vec<Item> =
    <items:ItemNode*> => items;

ItemNode: Item = {
    FunctionDef,
    <start:@L> <v:VarDecl> <end:@R> => Item::VarItem(v),
    <start:@L> <p:PreprocessorDirective> <end:@R> => Item::Preprocessor(p),
    <start:@L> <i:ImportDirective> <end:@R> => Item::Import(i),
    <start:@L> <p:PackageDirective> <end:@R> => Item::Package(p),
    <start:@L> <e:EnumDef> <end:@R> => Item::EnumItem(e),
    <start:@L> <s:StructDef> <end:@R> => Item::StructItem(s),
};

PreprocessorDirective: String = {
    Preprocessor <id:Ident> => id,
};

ImportDirective: String = {
    Import <id:Ident> Semi => id,
};

PackageDirective: String = {
    Package <id:Ident> Semi => id,
};

EnumDef: Enum = 
    <start:@L> <is_pub:PublicKw> Enum <name:Ident> LBrace <variants:EnumVariantList> RBrace <end:@R> => {
        Enum {
            ident: name,
            variants,
            is_public: is_pub,
            span: Span::new(start, end),
        }
    };


StructDef: Struct =
    <start:@L> <is_pub:PublicKw> Struct <name:Ident> LBrace <fields:StructFieldList> RBrace <end:@R> => {
        Struct {
            ident: name,
            fields,
            is_public: is_pub,
            _methods: vec![],
            span: Span::new(start, end),
        }
};

StructFieldList: Vec<StructField> = {
    => vec![],
    <first:StructFieldNode> <rest:(Comma <StructFieldNode>)*> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};


StructFieldNode: StructField = {
    <start:@L> <id:Ident> <ty:FieldType?> <def:FieldDefault?> <end:@R> => StructField {
        ident: id,
        ty,
        default_value: def,
        span: Span::new(start, end),
    }
};

EnumVariantList: Vec<String> = {
    => vec![],
    <first:Ident> <rest:MoreEnumVariants> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

MoreEnumVariants: Vec<String> = {
    => vec![],
    Comma <tail:EnumVariantTail> => tail,
};

EnumVariantTail: Vec<String> = {
    => vec![],
    <v:Ident> <rest:MoreEnumVariants> => {
        let mut v = vec![v];
        v.extend(rest);
        v
    }
};

FieldType: Type = {
    GtGt <t:Type> => t,
};

FieldDefault: Spanned<Expr> = {
    Assign <e:Expr> => e,
};

FnKw: () = <tok:Function> => ();

PublicKw: bool = {
    Public => true,
    => false,
};

FunctionDef: Item =
   <start:@L> <is_pub:PublicKw> FnKw <name:Ident> LParen <params:ParamList> RParen <ret:ReturnType> <body:Block> <end:@R> => {
        Item::FunctionItem(Function {
            ident: name,
            params,
            ret_ty: ret,
            blk: body,
            is_public: is_pub,
            span: Span::new(start, end),
        })
    };

ParamList: Vec<FunctionParam> = {
    => vec![],
    <first:FunctionParamNode> <rest:(Comma <FunctionParamNode>)*> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

FunctionParamNode: FunctionParam = {
    <start:@L> <id:Ident> GtGt <t:Type> <end:@R> => FunctionParam { ident: id, ty: Some(t), span: Span::new(start, end) },
    <start:@L> <id:Ident> <end:@R> => FunctionParam { ident: id, ty: None, span: Span::new(start, end) },
};


Type: Type = {
    TypeInt => Type::Int,
    TypeFloat => Type::Float,
    TypeBool => Type::Bool,
    TypeStr => Type::Str,
    TypeUnit => Type::Unit,

    TypeI8 => Type::TypeI8,
    TypeU8 => Type::TypeU8,
    TypeI16 => Type::TypeI16,
    TypeU16 => Type::TypeU16,
    TypeI32 => Type::TypeI32,
    TypeU32 => Type::TypeU32,
    TypeI64 => Type::TypeI64,
    TypeU64 => Type::TypeU64,

    TypeF16 => Type::TypeF16,
    TypeF32 => Type::TypeF32,
    TypeF64 => Type::TypeF64,
};


ReturnType: Option<Type> = {
    GtGt <t:Type> => Some(t),
    => None,
};

ArgList: Vec<Spanned<Expr>> = {
    => vec![],
    <e:Expr> => vec![e],
    <first:Expr> Comma <rest:ArgListTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

ArgListTail: Vec<Spanned<Expr>> = {
    <e:Expr> => vec![e],
    <first:Expr> Comma <rest:ArgListTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

Block: Vec<Spanned<Stmt>> =
    LBrace <stmts:Stmts> RBrace => stmts;

Stmts: Vec<Spanned<Stmt>> = {
    => vec![],
    <mut stmts:Stmts> <s:Stmt> => { stmts.push(s); stmts }
};

Stmt: Spanned<Stmt> = {
    <start:@L> <v:VarDecl> <end:@R> => Spanned::new(Stmt::Var(v), Span::new(start, end)),
    <start:@L> <e:Expr> <tail:StmtTail> <end:@R> =>? {
        match tail {
            None => Ok(Spanned::new(Stmt::Expr(e), Span::new(start, end))),
            Some(val) => {
                if let Expr::Var(id) = e.node {
                    Ok(Spanned::new(Stmt::Assign(AssignStmt { name: id, expr: val, span: Span::new(start, end) }), Span::new(start, end)))
                } else {
                    Err(ParseError::User { error: "Invalid assignment target".to_string() })
                }
            }
        }
    },
    IfStmt,
    <start:@L> While <c:Expr> <body:Block> <end:@R> =>
        Spanned::new(Stmt::While {
            cond: c,
            body: body,
        }, Span::new(start, end)),
    <start:@L> Return <e:Expr> Semi <end:@R> => Spanned::new(Stmt::Return(Some(e)), Span::new(start, end)),
    <start:@L> Return Semi <end:@R> => Spanned::new(Stmt::Return(None), Span::new(start, end)),
}

#[inline]
IfStmt: Spanned<Stmt> = {
    <start:@L> If <c:Expr> <then:Block> <end:@R> => Spanned::new(Stmt::If {
        cond: c,
        then_blk: then,
        else_blk: None,
    }, Span::new(start, end)),
    <start:@L> If <c:Expr> <then:Block> Else <else_blk:Block> <end:@R> => Spanned::new(Stmt::If {
        cond: c,
        then_blk: then,
        else_blk: Some(else_blk),
    }, Span::new(start, end)),
};

StmtTail: Option<Spanned<Expr>> = {
    Semi => None,
    Assign <e:Expr> Semi => Some(e),
};


VarDecl: VarDecl = {
 <start:@L> Var <id:Ident> Assign <e:Expr> Semi <end:@R> => VarDecl { ident: id, expr: Some(e), span: Span::new(start, end) },
 <start:@L> Var <id:Ident> Semi <end:@R> => VarDecl { ident: id, expr: None, span: Span::new(start, end) },
};

Ident: String = <tok:IDENT> =>? {
    match tok { Token::Ident(s) => Ok(s), _ => Err(ParseError::User { error: "Expected IDENT token".to_string() }) }
};

MacroName: String = <tok:MACRO> =>? {
    match tok { Token::Macro(s) => Ok(s), _ => Err(ParseError::User { error: "Expected MACRO token".to_string() }) }
};
Num: i64     = <tok:NUM>   =>? {
    match tok { Token::Num(n) => Ok(n), _ => Err(ParseError::User { error: "Expected NUM token".to_string() }) }
};

Float: f64     = <tok:FLOAT>   =>? {
    match tok { Token::Float(f) => Ok(f), _ => Err(ParseError::User { error: "Expected FLOAT token".to_string() }) }
};

StringLiteral: String = {
    <s:StrLiteral> =>? {
        match s {
            Token::StrLiteral(str) => Ok(str),
            _ => Err(ParseError::User { error: "Expected StrLiteral token".to_string() }),
        }
    }
};

BooleanLiteral: bool = {
    TRUE => true,
    FALSE => false,
};


Expr: Spanned<Expr> = RangeExpr;

RangeExpr: Spanned<Expr> = {
    <start:@L> <l:Comparison> DotDot <r:Comparison> <end:@R> => Spanned::new(Expr::Range(Box::new(l), Box::new(r)), Span::new(start, end)),
    <e:Comparison> => e,
}

Comparison: Spanned<Expr> = {
    <start:@L> <l:Comparison> EqEq <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Eq(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:Comparison> Neq <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Neq(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:Comparison> Lt <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Lt(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:Comparison> Gt <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Gt(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:Comparison> Le <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Le(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:Comparison> Ge <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Ge(Box::new(l), Box::new(r)), Span::new(start, end)),
    <a:AddAndMinus>                   => a,
}

AddAndMinus: Spanned<Expr> = {
    <start:@L> <l:AddAndMinus> Plus <r:MulAndDivAndMod> <end:@R> => Spanned::new(Expr::Add(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:AddAndMinus> Minus <r:MulAndDivAndMod> <end:@R> => Spanned::new(Expr::Minus(Box::new(l), Box::new(r)), Span::new(start, end)),
    <m:MulAndDivAndMod>              => m,
}

MulAndDivAndMod: Spanned<Expr> = {
    <start:@L> <l:MulAndDivAndMod> Star <r:Unary> <end:@R> => Spanned::new(Expr::Mul(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:MulAndDivAndMod> Div <r:Unary> <end:@R> => Spanned::new(Expr::Div(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:MulAndDivAndMod> Mod <r:Unary> <end:@R> => Spanned::new(Expr::Mod(Box::new(l), Box::new(r)), Span::new(start, end)),
    <u:Unary> => u,
}

Unary: Spanned<Expr> = {
    <start:@L> Minus <p:Unary> <end:@R> => Spanned::new(Expr::Neg(Box::new(p)), Span::new(start, end)),
    <p: Postfix> => p,
}

Postfix: Spanned<Expr> = {
    <start:@L> <base:Postfix> LBracket <index:Expr> RBracket <end:@R> => Spanned::new(Expr::Index(Box::new(base), Box::new(index)), Span::new(start, end)),
    <start:@L> <e:Postfix> PlusPlus <end:@R> => Spanned::new(Expr::Increment(Box::new(e)), Span::new(start, end)),
    <start:@L> <e:Postfix> MinusMinus <end:@R> => Spanned::new(Expr::Decrement(Box::new(e)), Span::new(start, end)),
    <start:@L> <base:Postfix> Dot <field:Ident> LParen RParen <end:@R> => {
        if let Expr::Var(mod_name) = base.node {
            Spanned::new(Expr::ModuleAccess(mod_name, field, vec![]), Span::new(start, end))
        } else {
            Spanned::new(Expr::Call(field, vec![], None), Span::new(start, end))
        }
    },
    <start:@L> <base:Postfix> Dot <field:Ident> LParen <first:Expr> <rest:(Comma <Expr>)*> RParen <end:@R> => {
        let mut args = vec![first];
        args.extend(rest);
        if let Expr::Var(mod_name) = base.node {
            Spanned::new(Expr::ModuleAccess(mod_name, field, args), Span::new(start, end))
        } else {
            Spanned::new(Expr::Call(field, args, None), Span::new(start, end))
        }
    },
    <start:@L> <base:Postfix> Dot <field:Ident> <end:@R> => {
        if let Expr::Var(val) = base.node {
            Spanned::new(Expr::FieldAccess(Box::new(Spanned::new(Expr::Var(val), base.span)), field), Span::new(start, end))
        } else {
            Spanned::new(Expr::FieldAccess(Box::new(base), field), Span::new(start, end))
        }
    },
    <start:@L> <base:Postfix> Question <end:@R> => Spanned::new(Expr::Try(Box::new(base)), Span::new(start, end)),
    <f:Atom> => f,
}

Atom: Spanned<Expr> = {
    <start:@L> <m:MacroName> LParen RParen <end:@R> => Spanned::new(Expr::Macro(m, vec![]), Span::new(start, end)),
    <start:@L> <m:MacroName> LParen <first:Expr> <rest:(Comma <Expr>)*> RParen <end:@R> => {
        let mut args = vec![first];
        args.extend(rest);
        Spanned::new(Expr::Macro(m, args), Span::new(start, end))
    },
    <start:@L> <m:MacroName> LParen <name:Ident> LBrace <fields:StructInitFields> RBrace RParen <end:@R> =>? {
        if m == "init" {
            Ok(Spanned::new(Expr::StructInit(name, fields), Span::new(start, end)))
        } else {
            Err(ParseError::User { error: format!("Macro '{}' does not support struct init syntax. Use @init for struct initialization.", m) })
        }
    },
    <start:@L> <id:Ident> LParen RParen <end:@R> => Spanned::new(Expr::Call(id, vec![], None), Span::new(start, end)),
    <start:@L> <id:Ident> LParen <first:Expr> <rest:(Comma <Expr>)*> RParen <end:@R> => {
        let mut args = vec![first];
        args.extend(rest);
        Spanned::new(Expr::Call(id, args, None), Span::new(start, end))
    },
    <start:@L> <id:Ident> <end:@R> => Spanned::new(Expr::Var(id), Span::new(start, end)),
    <start:@L> <n:Num> <end:@R> => Spanned::new(Expr::Number(n), Span::new(start, end)),
    <start:@L> <f:Float> <end:@R> => Spanned::new(Expr::Float(f), Span::new(start, end)),
    <start:@L> <s:StringLiteral> <end:@R> => Spanned::new(Expr::Str(s), Span::new(start, end)),
    <start:@L> <b:BooleanLiteral> <end:@R> => Spanned::new(Expr::Bool(b), Span::new(start, end)),
    <start:@L> <i:TypeI8> <end:@R> => Spanned::new(Expr::TypeI8, Span::new(start, end)),
    <start:@L> <u:TypeU8> <end:@R> => Spanned::new(Expr::TypeU8, Span::new(start, end)),
    <start:@L> <i:TypeI16> <end:@R> => Spanned::new(Expr::TypeI16, Span::new(start, end)),
    <start:@L> <u:TypeU16> <end:@R> => Spanned::new(Expr::TypeU16, Span::new(start, end)),
    <start:@L> <i:TypeI32> <end:@R> => Spanned::new(Expr::TypeI32, Span::new(start, end)),
    <start:@L> <u:TypeU32> <end:@R> => Spanned::new(Expr::TypeU32, Span::new(start, end)),
    <start:@L> <i:TypeI64> <end:@R> => Spanned::new(Expr::TypeI64, Span::new(start, end)),
    <start:@L> <u:TypeU64> <end:@R> => Spanned::new(Expr::TypeU64, Span::new(start, end)),
    <start:@L> <f:TypeF16> <end:@R> => Spanned::new(Expr::TypeF16, Span::new(start, end)),
    <start:@L> <f:TypeF32> <end:@R> => Spanned::new(Expr::TypeF32, Span::new(start, end)),
    <start:@L> <f:TypeF64> <end:@R> => Spanned::new(Expr::TypeF64, Span::new(start, end)),
    <start:@L> LParen RParen <end:@R> => Spanned::new(Expr::Unit(), Span::new(start, end)),
    <start:@L> LParen <e:Expr> RParen <end:@R> => Spanned::new(e.node, Span::new(start, end)),
    <start:@L> LBracket RBracket <end:@R> => Spanned::new(Expr::List(vec![]), Span::new(start, end)),
    <start:@L> LBracket <first:Expr> <rest:(Comma <Expr>)*> RBracket <end:@R> => {
        let mut v = vec![first];
        v.extend(rest);
        Spanned::new(Expr::List(v), Span::new(start, end))
    },
};


StructInitFields: Vec<(String, Spanned<Expr>)> = {
    => vec![],
    <f:StructInitField> => vec![f],
    <first:StructInitField> Comma <rest:StructInitFieldsTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

StructInitFieldsTail: Vec<(String, Spanned<Expr>)> = {
    <f:StructInitField> => vec![f],
    <first:StructInitField> Comma <rest:StructInitFieldsTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

StructInitField: (String, Spanned<Expr>) = {
    <id:Ident> Assign <e:Expr> => (id, e),
};
