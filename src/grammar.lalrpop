grammar;

use crate::front::ast::{
    Item, 
    VarDecl, 
    Expr, 
    Stmt, 
    Function, 
    FunctionParam, 
    Enum, 
    AssignStmt,
    Struct,
    StructField,
    Suffix,
    LabelName,
    MatchPat,
    MatchArm,
    MatchArmBody,
    ExprMatchArm,
    parse_dynamic_label_template,
};
use crate::front::span::{Span, Spanned};
use crate::front::lexer::Token;
use crate::front::type_helper::{Type, TypeAnnot};
use lalrpop_util::ParseError;
use half::f16;

extern {
    type Location = usize;
    type Error = String;

    enum Token {
        LBrace => Token::LBrace,
        RBrace => Token::RBrace,
        LBracket => Token::LBracket,
        RBracket => Token::RBracket,
        LParen => Token::LParen,
        RParen => Token::RParen,
        Plus   => Token::Plus,
        PlusPlus => Token::PlusPlus,
        Star   => Token::Star,
        Minus  => Token::Minus,
        MinusMinus => Token::MinusMinus,
        Div    => Token::Div,
        Mod    => Token::Mod,
        Assign => Token::Assign,
        EqEq   => Token::EqEq,
        Neq    => Token::Neq,
        Lt     => Token::Lt,
        LtColon => Token::LtColon,
        Gt     => Token::Gt,
        GtGt   => Token::GtGt,
        Question => Token::Question,
        QuestionLParen => Token::QuestionLParen,
        Match => Token::Match,
        Case => Token::Case,
        Break => Token::Break,
        FatArrow => Token::FatArrow,
        Le     => Token::Le,
        Ge     => Token::Ge,
        Dot    => Token::Dot,
        DotDot => Token::DotDot,
        Semi   => Token::Semi,
        StrLiteral => Token::StrLiteral(String),
        If     => Token::If,
        Else   => Token::Else,
        While  => Token::While,
        IDENT  => Token::Ident(<String>),
        MACRO  => Token::Macro(String),
        NUM    => Token::Num(i64),
        FLOAT  => Token::Float(f64),
        TRUE  => Token::Bool(true),
        FALSE => Token::Bool(false),
        Comma  => Token::Comma,
        Colon  => Token::Colon,
        Function => Token::Function,
        Return => Token::Return,
        PREPROCESSOR => Token::Preprocessor(<String>),
        Import => Token::Import,
        Package => Token::Package,
        Var => Token::Var,
        Public => Token::Public,
        Enum => Token::Enum,
        Struct => Token::Struct,
        Copy => Token::Copy,
        Ambi => Token::Ambi,
        InstanceCreate => Token::InstanceCreate,
        Destroy => Token::Destroy,
        Exist => Token::Exist,
        Unsafe => Token::Unsafe,
        Defer => Token::Defer,

        // System types
        TypeInt => Token::TypeInt,
        TypeFloat => Token::TypeFloat,
        TypeBool => Token::TypeBool,
        TypeStr => Token::TypeStr,
        TypeList => Token::TypeList,
        TypeBuffer => Token::TypeBuffer,
        TypeRawPtr => Token::TypeRawPtr,
        TypeRange => Token::TypeRange,
        TypeUnit => Token::TypeUnit,
        TypeError => Token::TypeError,
        TypeLabel => Token::TypeLabel,
        TypeAtomKw => Token::TypeAtomKw,

        TypeI8 => Token::TypeI8,
        TypeU8 => Token::TypeU8,
        TypeI16 => Token::TypeI16,
        TypeU16 => Token::TypeU16,
        TypeI32 => Token::TypeI32,
        TypeU32 => Token::TypeU32,
        TypeI64 => Token::TypeI64,
        TypeU64 => Token::TypeU64,

        TypeF16 => Token::TypeF16,
        TypeF32 => Token::TypeF32,
        TypeF64 => Token::TypeF64,
    }
}

pub Start: Vec<Item> =
    <items:ItemNode*> => items;

ItemNode: Item = {
    FunctionDef,
    <start:@L> <v:VarDecl> <end:@R> => Item::VarItem(v),
    <start:@L> <p:PreprocessorDirective> <end:@R> => Item::Preprocessor(p),
    <start:@L> <i:ImportDirective> <end:@R> => Item::Import(i),
    <start:@L> <p:PackageDirective> <end:@R> => Item::Package(p),
    <start:@L> <e:EnumDef> <end:@R> => Item::EnumItem(e),
    <start:@L> <s:StructDef> <end:@R> => Item::StructItem(s),
};

PreprocessorDirective: String = {
    PREPROCESSOR,
};

ImportDirective: String = {
    Import <id:Ident> Semi => id,
};

PackageDirective: String = {
    Package <id:Ident> Semi => id,
};

EnumDef: Enum = 
    <start:@L> <is_pub:PublicKw> Enum <name:Ident> LBrace <variants:EnumVariantList> RBrace <end:@R> => {
        Enum {
            ident: name,
            variants,
            is_public: is_pub,
            span: Span::new(start, end),
        }
    };


StructDef: Struct =
    <start:@L> <is_pub:PublicKw> Struct <name:Ident> LBrace <fields:StructFieldList> RBrace <end:@R> => {
        Struct {
            ident: name,
            fields,
            is_public: is_pub,
            _methods: vec![],
            span: Span::new(start, end),
        }
};

StructFieldList: Vec<StructField> = {
    => vec![],
    <first:StructFieldNode> <rest:(Comma <StructFieldNode>)*> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};


StructFieldNode: StructField = {
    <start:@L> <id:Ident> <ty:FieldType?> <def:FieldDefault?> <end:@R> => StructField {
        ident: id,
        ty,
        default_value: def,
        span: Span::new(start, end),
    }
};

EnumVariantList: Vec<String> = {
    => vec![],
    <first:Ident> <rest:MoreEnumVariants> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

MoreEnumVariants: Vec<String> = {
    => vec![],
    Comma <tail:EnumVariantTail> => tail,
};

EnumVariantTail: Vec<String> = {
    => vec![],
    <v:Ident> <rest:MoreEnumVariants> => {
        let mut v = vec![v];
        v.extend(rest);
        v
    }
};

FieldType: Type = {
    GtGt <t:Type> => t,
};

FieldDefault: Spanned<Expr> = {
    Assign <e:Expr> => e,
};

FnKw: () = <tok:Function> => ();

PublicKw: bool = {
    Public => true,
    => false,
};

FunctionDef: Item =
   <start:@L> <is_pub:PublicKw> FnKw <name:Ident> LParen <params:ParamList> RParen <ret:ReturnType> <body:Block> <end:@R> => {
        Item::FunctionItem(Function {
            ident: name,
            params,
            ret_ty: ret,
            blk: body,
            is_public: is_pub,
            span: Span::new(start, end),
        })
    };

ParamList: Vec<FunctionParam> = {
    => vec![],
    <first:FunctionParamNode> <rest:(Comma <FunctionParamNode>)*> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

FunctionParamNode: FunctionParam = {
    <start:@L> <id:ParamIdent> GtGt <t:TypeAnnot> <end:@R> => FunctionParam { ident: id, ty: Some(t), span: Span::new(start, end) },
    <start:@L> <id:ParamIdent> <end:@R> => FunctionParam { ident: id, ty: None, span: Span::new(start, end) },
};


TypeAnnot: TypeAnnot = {
    Ambi <t:Type> => TypeAnnot { ty: t, ambi: true },
    <t:Type> => TypeAnnot { ty: t, ambi: false },
};

Type: Type = {
    TypeInt => Type::Int,
    TypeFloat => Type::Float,
    TypeBool => Type::Bool,
    TypeStr => Type::Str,
    TypeList => Type::List,
    TypeBuffer => Type::Buffer,
    TypeRawPtr => Type::RawPtr,
    TypeRange => Type::Range,
    TypeUnit => Type::Unit,
    // `err` sugar: `{:error, reason}` label.
    TypeError => Type::App("Label".into(), vec![Type::Atom("error".into()), Type::Any]),
    TypeLabel => Type::Label,
    TypeAtomKw => Type::AtomVal,

    // Named label/atom argument: `Label(:ok, int)`, `Atom(:ok)`. Compile-time only.
    Colon <id:Ident> => Type::Atom(id),

    TypeI8 => Type::TypeI8,
    TypeU8 => Type::TypeU8,
    TypeI16 => Type::TypeI16,
    TypeU16 => Type::TypeU16,
    TypeI32 => Type::TypeI32,
    TypeU32 => Type::TypeU32,
    TypeI64 => Type::TypeI64,
    TypeU64 => Type::TypeU64,

    TypeF16 => Type::TypeF16,
    TypeF32 => Type::TypeF32,
    TypeF64 => Type::TypeF64,

    // Type application: `List(int)`, `Result(int, err)`, `List()` …
    // Bare idents are not `Param` yet (generics / #29).
    <name:Ident> LParen <args:TypeArgList> RParen => Type::App(name, args),
};

TypeArgList: Vec<Type> = {
    => vec![],
    <first:Type> <rest:(Comma <Type>)*> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    },
};


ReturnType: Option<Type> = {
    // `ambi` on return is accepted syntactically but ignored (return slots are not rebound).
    GtGt <t:TypeAnnot> => Some(t.ty),
    => None,
};

ArgList: Vec<Spanned<Expr>> = {
    => vec![],
    <e:Expr> => vec![e],
    <first:Expr> Comma <rest:ArgListTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

ArgListTail: Vec<Spanned<Expr>> = {
    <e:Expr> => vec![e],
    <first:Expr> Comma <rest:ArgListTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

Block: Vec<Spanned<Stmt>> =
    LBrace <stmts:Stmts> RBrace => stmts;

Stmts: Vec<Spanned<Stmt>> = {
    => vec![],
    <mut stmts:Stmts> <s:Stmt> => { stmts.push(s); stmts }
};

Stmt: Spanned<Stmt> = {
    <start:@L> <v:VarDecl> <end:@R> => Spanned::new(Stmt::Var(v), Span::new(start, end)),
    <start:@L> <e:ExprNoMatch> <tail:StmtTail> <end:@R> =>? {
        match tail {
            None => Ok(Spanned::new(Stmt::Expr(e), Span::new(start, end))),
            Some(val) => {
                if let Expr::Var(id) = e.node {
                    Ok(Spanned::new(Stmt::Assign(AssignStmt { name: id, expr: val, span: Span::new(start, end) }), Span::new(start, end)))
                } else if let Expr::Index(collection, index) = e.node {
                    Ok(Spanned::new(Stmt::IndexAssign { collection: *collection, index: *index, expr: val, span: Span::new(start, end) }, Span::new(start, end)))
                } else {
                    Err(ParseError::User { error: "Invalid assignment target".to_string() })
                }
            }
        }
    },
    IfStmt,
    MatchStmt,
    <start:@L> While <c:Expr> <body:Block> <end:@R> =>
        Spanned::new(Stmt::While {
            cond: c,
            body: body,
        }, Span::new(start, end)),
    <start:@L> Unsafe <body:Block> <end:@R> =>
        Spanned::new(Stmt::Unsafe {
            body: body,
            span: Span::new(start, end),
        }, Span::new(start, end)),
    <start:@L> Defer <e:Expr> Semi <end:@R> =>
        Spanned::new(Stmt::Defer {
            expr: e,
            span: Span::new(start, end),
        }, Span::new(start, end)),
    <start:@L> Return <e:Expr> Semi <end:@R> => Spanned::new(Stmt::Return(Some(e)), Span::new(start, end)),
    <start:@L> Return Semi <end:@R> => Spanned::new(Stmt::Return(None), Span::new(start, end)),
}

#[inline]
IfStmt: Spanned<Stmt> = {
    <start:@L> If <c:Expr> <then:Block> <end:@R> => Spanned::new(Stmt::If {
        cond: c,
        then_blk: then,
        else_blk: None,
    }, Span::new(start, end)),
    <start:@L> If <c:Expr> <then:Block> Else <else_blk:Block> <end:@R> => Spanned::new(Stmt::If {
        cond: c,
        then_blk: then,
        else_blk: Some(else_blk),
    }, Span::new(start, end)),
};

/// `match <scrutinee> ?(var name) { case PAT => expr break; ... }` (bind form)
/// or `match <scrutinee> { case PAT => { stmts } ... }` (no-bind form).
///
/// The bind form takes a full Expr as scrutinee: `?(` is a single lexer token
/// (QuestionLParen), so the bind `?` never competes with the postfix Try `?`.
/// `match x? {` (Try, no bind) and `match x ?(var r) {` (bind) separate on the
/// lookahead after the Expr is reduced.
MatchStmt: Spanned<Stmt> = {
    // bind: `match <Expr> ?(var name) { ... }`
    <start:@L> Match <e:Expr> QuestionLParen Var <bind:Ident> RParen
        LBrace <arms:MatchArmsBind> RBrace <end:@R>
      => Spanned::new(Stmt::Match {
          scrutinee: e,
          bind: Some(bind),
          arms,
          span: Span::new(start, end),
      }, Span::new(start, end)),

    // no bind: `match <Expr> { case PAT => { ... } }`
    <start:@L> Match <e:Expr> LBrace <arms:MatchArmsBlock> RBrace <end:@R>
      => Spanned::new(Stmt::Match {
          scrutinee: e,
          bind: None,
          arms,
          span: Span::new(start, end),
      }, Span::new(start, end)),
};

MatchArmsBind: Vec<MatchArm> = {
    <a:MatchArmBind> => vec![a],
    <a:MatchArmBind> <rest:MatchArmsBind> => {
        let mut v = vec![a];
        v.extend(rest);
        v
    }
};

MatchArmBind: MatchArm = {
    <start:@L> Case <pat:MatchPatNode> FatArrow <e:Expr> Break Semi <end:@R> => MatchArm {
        pat,
        body: MatchArmBody::ExprBreak(e),
        span: Span::new(start, end),
    },
};

MatchArmsBlock: Vec<MatchArm> = {
    <a:MatchArmBlock> => vec![a],
    <a:MatchArmBlock> <rest:MatchArmsBlock> => {
        let mut v = vec![a];
        v.extend(rest);
        v
    }
};

MatchArmBlock: MatchArm = {
    <start:@L> Case <pat:MatchPatNode> FatArrow <body:Block> <end:@R> => MatchArm {
        pat,
        body: MatchArmBody::Block(body),
        span: Span::new(start, end),
    },
};

MatchArmsExpr: Vec<ExprMatchArm> = {
    <a:MatchArmExpr> => vec![a],
    <a:MatchArmExpr> <rest:MatchArmsExpr> => {
        let mut v = vec![a];
        v.extend(rest);
        v
    }
};

MatchArmExpr: ExprMatchArm = {
    <start:@L> Case <pat:MatchPatNode> FatArrow <e:Expr> <end:@R> => ExprMatchArm {
        pat,
        value: e,
        span: Span::new(start, end),
    },
};

MatchPatNode: MatchPat = {
    Colon <id:Ident> => MatchPat::Name(LabelName::Static(id)),
    LBrace Colon <id:Ident> Comma <binder:Ident> RBrace =>
        MatchPat::LabelPayload { name: LabelName::Static(id), binder },
    <id:Ident> =>? {
        if id == "_" {
            Ok(MatchPat::Wildcard)
        } else {
            Err(ParseError::User {
                error: "match pattern must be :name, {:name, binder}, or _".into(),
            })
        }
    },
};

StmtTail: Option<Spanned<Expr>> = {
    Semi => None,
    Assign <e:AssignExpr> Semi => Some(e),
};

AssignExpr: Spanned<Expr> = {
    <start:@L> <id:Ident> Assign <e:AssignExpr> <end:@R> => Spanned::new(Expr::Assign(id, Box::new(e)), Span::new(start, end)),
    <e:Expr> => e,
};


VarDecl: VarDecl = {
 <start:@L> Var <id:VarIdent> Assign <e:Expr> Semi <end:@R> => VarDecl { ident: id, expr: Some(e), always_clone: false, span: Span::new(start, end) },
 <start:@L> Var <id:VarIdent> Semi <end:@R> => VarDecl { ident: id, expr: None, always_clone: false, span: Span::new(start, end) },
 <start:@L> Copy Var <id:VarIdent> Assign <e:Expr> Semi <end:@R> => VarDecl { ident: id, expr: Some(e), always_clone: true, span: Span::new(start, end) },
};

Ident: String = {
    IDENT,
    Function => "fn".to_string(),
    Case => "case".to_string(),
    Break => "break".to_string(),
    Package => "pkg".to_string(),
    Import => "import".to_string(),
    Var => "var".to_string(),
    Public => "pub".to_string(),
    Enum => "enum".to_string(),
    Struct => "struct".to_string(),
    Copy => "cp".to_string(),
    Ambi => "ambi".to_string(),
    Unsafe => "unsafe".to_string(),
    TypeInt => "int".to_string(),
    TypeFloat => "fp".to_string(),
    TypeBool => "bool".to_string(),
    TypeStr => "str".to_string(),
    TypeList => "list".to_string(),
    TypeBuffer => "buffer".to_string(),
    TypeRawPtr => "rawptr".to_string(),
    TypeRange => "range".to_string(),
    TypeUnit => "unit".to_string(),
    TypeError => "err".to_string(),
    TypeLabel => "label".to_string(),
    TypeAtomKw => "atom".to_string(),
};

ParamIdent: String = {
    Ident,
    InstanceCreate => "new".to_string(),
    Destroy => "destroy".to_string(),
    Exist => "exist".to_string(),
};

VarIdent: String = {
    Ident,
    Defer => "defer".to_string(),
};

MacroName: String = <tok:MACRO> =>? {
    match tok { Token::Macro(s) => Ok(s), _ => Err(ParseError::User { error: "Expected MACRO token".to_string() }) }
};
Num: i64     = <tok:NUM>   =>? {
    match tok { Token::Num(n) => Ok(n), _ => Err(ParseError::User { error: "Expected NUM token".to_string() }) }
};

Float: f64     = <tok:FLOAT>   =>? {
    match tok { Token::Float(f) => Ok(f), _ => Err(ParseError::User { error: "Expected FLOAT token".to_string() }) }
};

StringLiteral: String = {
    <s:StrLiteral> =>? {
        match s {
            Token::StrLiteral(str) => Ok(str),
            _ => Err(ParseError::User { error: "Expected StrLiteral token".to_string() }),
        }
    }
};

BooleanLiteral: bool = {
    TRUE => true,
    FALSE => false,
};


Expr: Spanned<Expr> = {
    <e:ExprNoMatch> => e,
    <start:@L> Match <e:Expr> LBrace <arms:MatchArmsExpr> RBrace <end:@R> =>
        Spanned::new(Expr::Match {
            scrutinee: Box::new(e),
            arms,
        }, Span::new(start, end)),
};

ExprNoMatch: Spanned<Expr> = {
    <start:@L> <l:Comparison> DotDot <r:Comparison> <end:@R> => Spanned::new(Expr::Range(Box::new(l), Box::new(r)), Span::new(start, end)),
    <e:Comparison> => e,
}

Comparison: Spanned<Expr> = {
    <start:@L> <l:Comparison> EqEq <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Eq(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:Comparison> Neq <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Neq(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:Comparison> Lt <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Lt(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:Comparison> Gt <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Gt(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:Comparison> Le <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Le(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:Comparison> Ge <r:AddAndMinus> <end:@R> => Spanned::new(Expr::Ge(Box::new(l), Box::new(r)), Span::new(start, end)),
    <a:AddAndMinus>                   => a,
}

AddAndMinus: Spanned<Expr> = {
    <start:@L> <l:AddAndMinus> Plus <r:MulAndDivAndMod> <end:@R> => Spanned::new(Expr::Add(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:AddAndMinus> Minus <r:MulAndDivAndMod> <end:@R> => Spanned::new(Expr::Minus(Box::new(l), Box::new(r)), Span::new(start, end)),
    <m:MulAndDivAndMod>              => m,
}

MulAndDivAndMod: Spanned<Expr> = {
    <start:@L> <l:MulAndDivAndMod> Star <r:Unary> <end:@R> => Spanned::new(Expr::Mul(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:MulAndDivAndMod> Div <r:Unary> <end:@R> => Spanned::new(Expr::Div(Box::new(l), Box::new(r)), Span::new(start, end)),
    <start:@L> <l:MulAndDivAndMod> Mod <r:Unary> <end:@R> => Spanned::new(Expr::Mod(Box::new(l), Box::new(r)), Span::new(start, end)),
    <u:Unary> => u,
}

Unary: Spanned<Expr> = {
    <start:@L> Minus <p:Unary> <end:@R> => Spanned::new(Expr::Neg(Box::new(p)), Span::new(start, end)),
    <p: Postfix> => p,
}

Postfix: Spanned<Expr> = {
    <start:@L> <base:Postfix> LBracket <index:Expr> RBracket <end:@R> => Spanned::new(Expr::Index(Box::new(base), Box::new(index)), Span::new(start, end)),
    <start:@L> <e:Postfix> PlusPlus <end:@R> => Spanned::new(Expr::Increment(Box::new(e)), Span::new(start, end)),
    <start:@L> <e:Postfix> MinusMinus <end:@R> => Spanned::new(Expr::Decrement(Box::new(e)), Span::new(start, end)),
    <start:@L> <base:Postfix> Dot <field:Ident> LParen RParen <end:@R> =>? {
        if let Expr::Var(mod_name) = base.node {
            Ok(Spanned::new(Expr::ModuleAccess(mod_name, field, vec![]), Span::new(start, end)))
        } else {
            Err(ParseError::User { error: "method call on non-module expression is not supported".to_string() })
        }
    },
    <start:@L> <base:Postfix> Dot <field:Ident> LParen <first:Expr> <rest:(Comma <Expr>)*> RParen <end:@R> =>? {
        let mut args = vec![first];
        args.extend(rest);
        if let Expr::Var(mod_name) = base.node {
            Ok(Spanned::new(Expr::ModuleAccess(mod_name, field, args), Span::new(start, end)))
        } else {
            Err(ParseError::User { error: "method call on non-module expression is not supported".to_string() })
        }
    },
    <start:@L> <base:Postfix> Dot <field:Ident> <end:@R> => {
        if let Expr::Var(val) = base.node {
            Spanned::new(Expr::FieldAccess(Box::new(Spanned::new(Expr::Var(val), base.span)), field), Span::new(start, end))
        } else {
            Spanned::new(Expr::FieldAccess(Box::new(base), field), Span::new(start, end))
        }
    },
    <start:@L> <base:Postfix> Question <end:@R> => Spanned::new(Expr::Try(Box::new(base)), Span::new(start, end)),
    <f:Atom> => f,
}

Atom: Spanned<Expr> = {
    <start:@L> <m:MacroName> LParen RParen <end:@R> => Spanned::new(Expr::Macro(m, vec![]), Span::new(start, end)),
    <start:@L> <m:MacroName> LParen <first:Expr> <rest:(Comma <Expr>)*> RParen <end:@R> => {
        let mut args = vec![first];
        args.extend(rest);
        Spanned::new(Expr::Macro(m, args), Span::new(start, end))
    },
    <start:@L> InstanceCreate LParen <size:Expr> RParen <end:@R> =>
        Spanned::new(Expr::HeapAlloc(Box::new(size)), Span::new(start, end)),
    <start:@L> Destroy LParen <e:Expr> RParen <end:@R> =>
        Spanned::new(Expr::Destroy(Box::new(e)), Span::new(start, end)),
    <start:@L> Exist LParen <e:Expr> RParen <end:@R> =>
        Spanned::new(Expr::Exist(Box::new(e)), Span::new(start, end)),
    <start:@L> InstanceCreate <end:@R> =>
        Spanned::new(Expr::Var("new".to_string()), Span::new(start, end)),
    <start:@L> Destroy <end:@R> =>
        Spanned::new(Expr::Var("destroy".to_string()), Span::new(start, end)),
    <start:@L> Exist <end:@R> =>
        Spanned::new(Expr::Var("exist".to_string()), Span::new(start, end)),
    <start:@L> <m:MacroName> LParen <name:Ident> LBrace <fields:StructInitFields> RBrace RParen <end:@R> =>? {
        if m == "init" {
            Ok(Spanned::new(Expr::StructInit(name, fields), Span::new(start, end)))
        } else {
            Err(ParseError::User { error: format!("Macro '{}' does not support struct init syntax. Use @init for struct initialization.", m) })
        }
    },
    <start:@L> <id:Ident> LParen RParen <end:@R> => Spanned::new(Expr::Call(id, vec![]), Span::new(start, end)),
    <start:@L> <id:Ident> LParen <first:Expr> <rest:(Comma <Expr>)*> RParen <end:@R> => {
        let mut args = vec![first];
        args.extend(rest);
        Spanned::new(Expr::Call(id, args), Span::new(start, end))
    },
    <start:@L> Colon <id:Ident> <end:@R> => Spanned::new(Expr::Atom(LabelName::Static(id)), Span::new(start, end)),
    <start:@L> Colon <s:StringLiteral> <end:@R> =>? {
        match parse_dynamic_label_template(&s) {
            Ok(parts) => Ok(Spanned::new(Expr::Atom(LabelName::Dynamic(parts)), Span::new(start, end))),
            Err(msg) => Err(ParseError::User { error: msg }),
        }
    },
    <start:@L> LBrace Colon <id:Ident> Comma <payload:Expr> RBrace <end:@R> => Spanned::new(Expr::Label(LabelName::Static(id), Box::new(payload)), Span::new(start, end)),
    <start:@L> LBrace Colon <s:StringLiteral> Comma <payload:Expr> RBrace <end:@R> =>? {
        match parse_dynamic_label_template(&s) {
            Ok(parts) => Ok(Spanned::new(Expr::Label(LabelName::Dynamic(parts), Box::new(payload)), Span::new(start, end))),
            Err(msg) => Err(ParseError::User { error: msg }),
        }
    },
    <start:@L> LtColon <id:Ident> <end:@R> => Spanned::new(Expr::AttachSlot(id), Span::new(start, end)),
    <start:@L> <id:Ident> <end:@R> => Spanned::new(Expr::Var(id), Span::new(start, end)),
    <start:@L> <n:Num> <end:@R> => Spanned::new(Expr::Number(n), Span::new(start, end)),
    <start:@L> <f:Float> <end:@R> => Spanned::new(Expr::Float(f), Span::new(start, end)),
    <start:@L> <s:StringLiteral> <end:@R> => Spanned::new(Expr::Str(s), Span::new(start, end)),
    <start:@L> <b:BooleanLiteral> <end:@R> => Spanned::new(Expr::Bool(b), Span::new(start, end)),
    <start:@L> <i:TypeI8> <end:@R> => Spanned::new(Expr::TypeI8, Span::new(start, end)),
    <start:@L> <u:TypeU8> <end:@R> => Spanned::new(Expr::TypeU8, Span::new(start, end)),
    <start:@L> <i:TypeI16> <end:@R> => Spanned::new(Expr::TypeI16, Span::new(start, end)),
    <start:@L> <u:TypeU16> <end:@R> => Spanned::new(Expr::TypeU16, Span::new(start, end)),
    <start:@L> <i:TypeI32> <end:@R> => Spanned::new(Expr::TypeI32, Span::new(start, end)),
    <start:@L> <u:TypeU32> <end:@R> => Spanned::new(Expr::TypeU32, Span::new(start, end)),
    <start:@L> <i:TypeI64> <end:@R> => Spanned::new(Expr::TypeI64, Span::new(start, end)),
    <start:@L> <u:TypeU64> <end:@R> => Spanned::new(Expr::TypeU64, Span::new(start, end)),
    <start:@L> <f:TypeF16> <end:@R> => Spanned::new(Expr::TypeF16, Span::new(start, end)),
    <start:@L> <f:TypeF32> <end:@R> => Spanned::new(Expr::TypeF32, Span::new(start, end)),
    <start:@L> <f:TypeF64> <end:@R> => Spanned::new(Expr::TypeF64, Span::new(start, end)),
    <start:@L> LParen RParen <end:@R> => Spanned::new(Expr::Unit(), Span::new(start, end)),
    <start:@L> LParen <e:Expr> RParen <end:@R> => Spanned::new(e.node, Span::new(start, end)),
    <start:@L> LBracket RBracket <end:@R> => Spanned::new(Expr::List(vec![]), Span::new(start, end)),
    <start:@L> LBracket <first:Expr> <rest:(Comma <Expr>)*> RBracket <end:@R> => {
        let mut v = vec![first];
        v.extend(rest);
        Spanned::new(Expr::List(v), Span::new(start, end))
    },
};


StructInitFields: Vec<(String, Spanned<Expr>)> = {
    => vec![],
    <f:StructInitField> => vec![f],
    <first:StructInitField> Comma <rest:StructInitFieldsTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

StructInitFieldsTail: Vec<(String, Spanned<Expr>)> = {
    <f:StructInitField> => vec![f],
    <first:StructInitField> Comma <rest:StructInitFieldsTail> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
};

StructInitField: (String, Spanned<Expr>) = {
    <id:Ident> Assign <e:Expr> => (id, e),
};
