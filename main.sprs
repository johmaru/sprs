pkg main;

# === Arithmetic ===

fn add_basic() >> i64 {
    return 5 + 3;
}

fn sub_basic() >> i64 {
    return 10 - 4;
}

fn mul_basic() >> i64 {
    return 6 * 7;
}

fn div_basic() >> i64 {
    return 20 / 4;
}

fn mod_basic() >> i64 {
    return 10 % 3;
}

fn neg_sub() >> i64 {
    return 5 - 10;
}

fn complex_expr() >> i64 {
    return (2 + 3) * 4 - 1;
}

fn precedence() >> i64 {
    return 2 + 3 * 4;
}

fn all_ops() >> i64 {
    return 100 / 7 * 10 + 100 % 7;
}

fn chained() >> i64 {
    return 1 + 2 + 3 + 4 + 5;
}

fn zero_div_pattern() >> i64 {
    return 0 / 1;
}

fn large_numbers() >> i64 {
    return 1000000 * 1000;
}

fn sub_to_zero() >> i64 {
    return 42 - 42;
}

# === Comparison ===

fn eq_true() >> i64 {
    if 5 == 5 then {
        return 1;
    }
    return 0;
}

fn eq_false() >> i64 {
    if 5 == 3 then {
        return 1;
    }
    return 0;
}

fn neq_true() >> i64 {
    if 5 != 3 then {
        return 1;
    }
    return 0;
}

fn neq_false() >> i64 {
    if 5 != 5 then {
        return 1;
    }
    return 0;
}

fn lt_true() >> i64 {
    if 3 < 5 then {
        return 1;
    }
    return 0;
}

fn lt_false() >> i64 {
    if 5 < 3 then {
        return 1;
    }
    return 0;
}

fn gt_true() >> i64 {
    if 5 > 3 then {
        return 1;
    }
    return 0;
}

fn gt_false() >> i64 {
    if 3 > 5 then {
        return 1;
    }
    return 0;
}

fn le_true() >> i64 {
    if 5 <= 5 then {
        return 1;
    }
    return 0;
}

fn le_false() >> i64 {
    if 6 <= 5 then {
        return 1;
    }
    return 0;
}

fn ge_true() >> i64 {
    if 5 >= 5 then {
        return 1;
    }
    return 0;
}

fn ge_false() >> i64 {
    if 4 >= 5 then {
        return 1;
    }
    return 0;
}

# === Control Flow ===

fn if_then() >> i64 {
    var x = 5;
    if x > 3 then {
        return 1;
    }
    return 0;
}

fn if_else() >> i64 {
    var x = 2;
    if x > 3 then {
        return 1;
    } else {
        return 2;
    }
    return 0;
}

fn if_elseif_chain() >> i64 {
    var x = 15;
    if x < 10 then {
        return 1;
    }
    if x < 20 then {
        return 2;
    }
    if x < 30 then {
        return 3;
    }
    return 0;
}

fn while_basic() >> i64 {
    var i = 0;
    var sum = 0;
    while i < 10 {
        sum = sum + i;
        i = i + 1;
    }
    return sum;
}

fn nested_if() >> i64 {
    var x = 5;
    var y = 10;
    if x > 0 then {
        if y > 5 then {
            return 1;
        }
        return 2;
    }
    return 0;
}

fn while_with_if() >> i64 {
    var i = 0;
    var found = 0;
    while i <= 20 {
        if i == 10 then {
            found = i;
        }
        i = i + 1;
    }
    return found;
}

fn if_returns_early() >> i64 {
    var x = 42;
    if x == 42 then {
        return 100;
    }
    return 0;
}

fn while_counter() >> i64 {
    var count = 0;
    var i = 0;
    while i < 100 {
        count = count + 1;
        i = i + 1;
    }
    return count;
}

# === Variables ===

fn var_assign() >> i64 {
    var x = 10;
    x = 20;
    return x;
}

fn var_reassign() >> i64 {
    var x = 1;
    x = 2;
    x = 3;
    return x;
}

fn multiple_vars() >> i64 {
    var a = 1;
    var b = 2;
    var c = 3;
    return a + b + c;
}

fn var_shadow() >> i64 {
    var x = 1;
    var x = 2;
    return x;
}

fn var_in_loop() >> i64 {
    var total = 0;
    var i = 0;
    while i < 5 {
        var temp = i * 2;
        total = total + temp;
        i = i + 1;
    }
    return total;
}

fn var_math() >> i64 {
    var a = 10;
    var b = 20;
    var c = a + b;
    var d = c * 2;
    return d;
}

# === Functions ===

# XFAIL: Var + Var with function args (runtime tag not Integer)
# fn add(a, b) >> i64 { return a + b; }
# fn call_with_args() >> i64 { return add(3, 4); }
# fn nested_calls() >> i64 { return add(add(1, 2), add(3, 4)); }
# fn function_with_locals() >> i64 {
#     var a = 10;
#     var b = 20;
#     var c = add(a, b);
#     return c;
# }

fn private_helper(n) >> i64 {
    return n * 2;
}

fn call_private() >> i64 {
    return private_helper(5);
}

fn factorial(n) >> i64 {
    if n <= 1 then {
        return 1;
    }
    return n * factorial(n - 1);
}

fn test_recursion() >> i64 {
    return factorial(5);
}

fn fibonacci(n) >> i64 {
    if n <= 1 then {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

fn test_fib() >> i64 {
    return fibonacci(10);
}

fn early_return() >> i64 {
    var x = 5;
    if x > 0 then {
        return 100;
    }
    return 0;
}

fn deep_recursion() >> i64 {
    return factorial(7);
}

# === Lists (list_push only, no index — create_index bug) ===

fn list_push_and_print() >> i64 {
    var y = [];
    `list_push(y, 42);
    `list_push(y, 100);
    `list_push(y, 200);
    return 1;
}

fn list_with_vars() >> i64 {
    var y = [];
    var z = 20;
    `list_push(y, z);
    var w = 30;
    `list_push(y, w);
    return 1;
}

fn list_build_loop() >> i64 {
    var y = [];
    var i = 0;
    while i < 5 {
        `list_push(y, i);
        i = i + 1;
    }
    return 1;
}

fn list_empty() >> i64 {
    var y = [];
    return 1;
}

# === Cast ===

fn cast_i8() >> i64 {
    return `cast(100, i8);
}

fn cast_u8() >> i64 {
    return `cast(200, u8);
}

fn cast_i16() >> i64 {
    return `cast(1000, i16);
}

fn cast_u16() >> i64 {
    return `cast(50000, u16);
}

fn cast_i32() >> i64 {
    return `cast(100000, i32);
}

fn cast_u32() >> i64 {
    return `cast(3000000000, u32);
}

fn cast_i64() >> i64 {
    return `cast(999999999999, i64);
}

fn cast_u64() >> i64 {
    return `cast(99999999999, u64);
}

fn cast_arithmetic() >> i64 {
    return `cast(10, i32) + `cast(5, i32);
}

fn cast_loop() >> i64 {
    var i = `cast(0, i8);
    var count = 0;
    while i < `cast(5, i8) {
        count = count + 1;
        i = i + `cast(1, i8);
    }
    return count;
}

# XFAIL: `cast + `cast with different types (infer_type Call bug)
# fn cast_mixed() >> i64 { return `cast(1, i8) + `cast(2, i16) + `cast(3, i32); }


# === Shift (lshift/rshift macros) ===

fn lshift_basic() >> i64 {
    return `lshift(1, 4);
}

fn lshift_zero() >> i64 {
    return `lshift(100, 0);
}

fn lshift_large() >> i64 {
    return `lshift(1, 20);
}

fn rshift_basic() >> i64 {
    return `rshift(256, 4);
}

fn rshift_zero() >> i64 {
    return `rshift(100, 0);
}

fn rshift_to_zero() >> i64 {
    return `rshift(1, 4);
}

fn shift_with_vars() >> i64 {
    var v = 16;
    var n = 2;
    return `lshift(v, n);
}

fn shift_in_expr() >> i64 {
    return `lshift(1, 4) + `rshift(256, 4);
}

fn rshift_signed_negative() >> i64 {
    var neg = 0 - 8;
    return `rshift(neg, 2);
}

fn lshift_then_rshift() >> i64 {
    var x = 3;
    return `rshift(`lshift(x, 4), 2);
}

fn shift_chain() >> i64 {
    return `lshift(`rshift(`lshift(255, 8), 4), 2);
}

fn rshift_all_bits() >> i64 {
    var v = 0 - 1;
    return `rshift(v, 63);
}

# === Not (`not macro) ===

fn not_zero() >> i64 {
    if `not(0) then { return 1; } else { return 0; }
    return 0;
}

fn not_nonzero() >> i64 {
    if `not(5) then { return 1; } else { return 0; }
    return 0;
}

fn not_negative() >> i64 {
    var v = 0 - 3;
    if `not(v) then { return 1; } else { return 0; }
    return 0;
}

fn not_expr() >> i64 {
    if `not(1 + 1) then { return 1; } else { return 0; }
    return 0;
}

fn not_in_if() >> i64 {
    if `not(0) then {
        return 42;
    } else {
        return 0;
    }
    return 0;
}
# === Float ===

fn float_add() >> fp {
    return 1.5 + 2.5;
}

fn float_sub() >> fp {
    return 10.0 - 3.5;
}

fn float_mul() >> fp {
    return 2.5 * 4.0;
}

fn float_div() >> fp {
    return 10.0 / 4.0;
}

fn float_complex() >> fp {
    return (1.5 + 2.5) * 2.0;
}

fn float_var_arith() >> fp {
    # XFAIL: return var (move semantics resets tag)
    var a = 5.2;
    var b = 7.3;
    return a + b;
}

# XFAIL: >> fp + `cast return (infer_type `cast bug)
# fn float_cast_f16() >> fp { return `cast(1.5, fp16); }
# fn float_cast_f32() >> fp { return `cast(3.14, fp32); }
# fn float_cast_f64() >> fp { return `cast(2.71828, fp64); }

fn float_while_loop() >> i64 {
    var v = `cast(0.0, fp16);
    var count = 0;
    while v < `cast(1.0, fp16) {
        count = count + 1;
        v = v + `cast(0.25, fp16);
    }
    return count;
}

fn float_nested() >> fp {
    return (1.0 + 2.0) * (3.0 + 4.0);
}

fn float_mixed() >> fp {
    # XFAIL: return var (move semantics resets tag)
    var x = 12.3;
    return x + 0.1;
}

# === String ===

fn get_greeting() >> str {
    return "hello" + " world";
}

fn get_static_str() >> str {
    return "sprs";
}

fn call_str_fn() >> i64 {
    var s = get_greeting();
    `println(s);
    var s2 = get_static_str();
    `println(s2);
    return 1;
}

# === Increment/Decrement ===

fn incr_basic() >> i64 {
    var x = 5;
    x++;
    return x;
}

fn decr_basic() >> i64 {
    var x = 5;
    x--;
    return x;
}

fn incr_in_loop() >> i64 {
    var i = 0;
    var count = 0;
    while i < 10 {
        count = count + 1;
        i++;
    }
    return count;
}

fn decr_in_loop() >> i64 {
    var i = 10;
    var count = 0;
    while i > 0 {
        count = count + 1;
        i--;
    }
    return count;
}

fn incr_multiple() >> i64 {
    var x = 0;
    x++;
    x++;
    x++;
    return x;
}

fn decr_to_zero() >> i64 {
    var x = 3;
    x--;
    x--;
    x--;
    return x;
}

fn incr_and_use() >> i64 {
    var x = 10;
    x++;
    var y = x;
    return y;
}

# === Struct ===

struct Point {
    x >> i64,
    y >> i64
}

fn struct_create_x() >> i64 {
    var p = Point {
        x = 10,
        y = 20
    };
    return p.x;
}

fn struct_create_y() >> i64 {
    var p = Point {
        x = 100,
        y = 200
    };
    return p.y;
}

fn struct_both_fields() >> i64 {
    var p = Point {
        x = 5,
        y = 15
    };
    return p.x + p.y;
}

fn struct_in_function() >> i64 {
    var p = Point {
        x = 1,
        y = 2
    };
    var sum = p.x + p.y;
    return sum;
}

# === Enum ===

enum Color {
    Red,
    Green,
    Blue
}

fn enum_access() >> i64 {
    var c = Color.Red;
    return 1;
}

fn enum_multiple() >> i64 {
    var a = Color.Red;
    var b = Color.Green;
    var c = Color.Blue;
    return 3;
}

fn enum_in_list() >> i64 {
    var y = [];
    `list_push(y, Color.Green);
    return 1;
}

# === Main ===

fn main() {
    `println("=== Arithmetic ===");
    `println(add_basic());
