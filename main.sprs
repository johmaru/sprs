    `println(lshift_zero());
    `println(lshift_large());
    `println(rshift_basic());
    `println(rshift_zero());
    `println(rshift_to_zero());
    `println(shift_with_vars());
    `println(shift_in_expr());
    `println(rshift_signed_negative());
    `println(lshift_then_rshift());
    `println(shift_chain());
    `println(rshift_all_bits());
    `println("=== Not ===");
    `println(not_zero());
    `println(not_nonzero());
    `println(not_negative());
    `println(not_expr());
    `println(not_in_if());
    `println("=== Float ===");
    `println(float_add());
    `println(float_sub());
    `println(float_mul());
    `println(float_div());
    `println(float_complex());
    `println(float_var_arith());
    # XFAIL: `cast >> fp (infer_type bug)
    # `println(float_cast_f16());
    # `println(float_cast_f32());
    # `println(float_cast_f64());
    `println(float_while_loop());
    `println(float_nested());
    `println(float_mixed());
    `println("=== String ===");
    `println(call_str_fn());
    `println(get_greeting());
    `println(get_static_str());

    `println("=== Increment ===");
    `println(incr_basic());
    `println(decr_basic());
    `println(incr_in_loop());
    `println(decr_in_loop());
    `println(incr_multiple());
