    `println(struct_in_function());

    `println("=== Enum ===");
    `println(enum_access());
    `println(enum_multiple());
    `println(enum_in_list());

    # XFAIL: Strings (>> str segfaults — Type::Str ptr bug)
    # XFAIL: list[index] (create_index StructValue panic)
    # XFAIL: return var (move semantics resets tag to Unit)

    `println("=== All Tests Done ===");
}
