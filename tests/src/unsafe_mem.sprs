# Language tests for unsafe / @raw / @free / RawPtr / defer.
# The `rawptr` type keyword was removed; the canonical type is `RawPtr`.
pkg unsafe_mem;

# 1. @raw moves Buffer ownership; exist(b) is false after @free.
pub fn raw_free_roundtrip() >> i64 {
    var b = new(2);
    b[0] = 7;
    b[1] = 8;
    unsafe {
        var p = @raw(b);
        @free(p);
    }
    if exist(b) {
        return 0;
    }
    return 1;
}

# 2. defer destroy runs at scope exit; auto-drop must not double-free.
pub fn defer_destroy_ok() >> i64 {
    var a = new(1);
    defer destroy(a);
    @buf_set(a, 0, 1);
    return 1;
}

# 3. defer destroy is a no-op after @raw; @free releases the allocation.
pub fn defer_with_raw_free() >> i64 {
    var a = new(2);
    defer destroy(a);
    unsafe {
        var p = @raw(a);
        @free(p);
    }
    return 1;
}

# 4. @println of a RawPtr (observability).
pub fn raw_ptr_print() >> i64 {
    var a = new(1);
    unsafe {
        var p = @raw(a);
        @println(p);
        @free(p);
    }
    return 1;
}

# 5. Print exist(b) before/after @raw — expect true then false.
pub fn raw_exist_demo() >> i64 {
    var b = new(1);
    @println(exist(b));          # expect: true
    unsafe {
        var p = @raw(b);
        @free(p);
    }
    @println(exist(b));          # expect: false
    return 1;
}
