pkg arithmetic;

# === Arithmetic ===

pub fn add_basic() >> i64 {
    return 5 + 3;
}

pub fn sub_basic() >> i64 {
    return 10 - 4;
}

pub fn mul_basic() >> i64 {
    return 6 * 7;
}

pub fn div_basic() >> i64 {
    return 20 / 4;
}

pub fn mod_basic() >> i64 {
    return 10 % 3;
}

pub fn neg_sub() >> i64 {
    return 5 - 10;
}

pub fn complex_expr() >> i64 {
    return (2 + 3) * 4 - 1;
}

pub fn precedence() >> i64 {
    return 2 + 3 * 4;
}

pub fn all_ops() >> i64 {
    return 100 / 7 * 10 + 100 % 7;
}

pub fn chained() >> i64 {
    return 1 + 2 + 3 + 4 + 5;
}

pub fn zero_div_pattern() >> i64 {
    return 0 / 1;
}

pub fn large_numbers() >> i64 {
    return 1000000 * 1000;
}

pub fn sub_to_zero() >> i64 {
    return 42 - 42;
}

pub fn div_by_zero() >> i64 {
    return 5 / 0;
}

pub fn mod_by_zero() >> i64 {
    return 5 % 0;
}

# === Increment/Decrement ===

pub fn incr_basic() >> i64 {
    var x = 5;
    x++;
    return x;
}

pub fn decr_basic() >> i64 {
    var x = 5;
    x--;
    return x;
}

pub fn incr_in_loop() >> i64 {
    var i = 0;
    var count = 0;
    while i < 10 {
        count = count + 1;
        i++;
    }
    return count;
}

pub fn decr_in_loop() >> i64 {
    var i = 10;
    var count = 0;
    while i > 0 {
        count = count + 1;
        i--;
    }
    return count;
}

pub fn incr_multiple() >> i64 {
    var x = 0;
    x++;
    x++;
    x++;
    return x;
}

pub fn decr_to_zero() >> i64 {
    var x = 3;
    x--;
    x--;
    x--;
    return x;
}

pub fn incr_and_use() >> i64 {
    var x = 10;
    x++;
    var y = x;
    return y;
}
