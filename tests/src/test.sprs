pkg test;

pub fn test() >> str {
            var a = 5 - 1;
            var b = 10;
            var c = "hello" + " world";

            @println(c);

            # test equality

            if a == 4 {
                return c;
            }

            # Keep >> str: i64 branches return a string marker instead of a++ / a+2.
            if a != 4 {
                return "neq";
            } else {
                return "eq-else";
            }

            return c;
        }