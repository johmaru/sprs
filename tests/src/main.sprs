    @println(comparison.eq_false());
    @println(comparison.neq_true());
    @println(comparison.neq_false());
    @println(comparison.lt_true());
    @println(comparison.lt_false());
    @println(comparison.gt_true());
    @println(comparison.gt_false());
    @println(comparison.le_true());
    @println(comparison.le_false());
    @println(comparison.ge_true());
    @println(comparison.ge_false());

    @println("=== Control Flow ===");
