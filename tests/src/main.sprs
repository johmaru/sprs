    @println(data_structures.list_empty());
    @println(data_structures.list_index_read());

    @println("=== Cast ===");
    @println(types.cast_i8());
    @println(types.cast_u8());
    @println(types.cast_i16());
    @println(types.cast_u16());
    @println(types.cast_i32());
    @println(types.cast_u32());
    @println(types.cast_i64());
    @println(types.cast_u64());
    @println(types.cast_arithmetic());
    @println(types.cast_loop());
    # @println(types.cast_mixed());
    # XFAIL: cast_mixed (infer_type Call bug)
    @println("=== BUG-L08 Verify ===");
    @println(types.cast_uint32_to_fp64());
    @println(types.cast_int32_to_fp64());
    @println("=== Shift ===");
    @println(comparison.lshift_basic());
    @println(comparison.lshift_zero());
    @println(comparison.lshift_large());
    @println(comparison.rshift_basic());
    @println(comparison.rshift_zero());
