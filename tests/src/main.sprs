    @println(variables.cp_move_invalidates());
    @println(variables.cp_assign_keeps_source());
    @println(variables.assign_moves_string());
    @println(variables.self_assign_string());
    @println(variables.cp_call_twice());

    @println("=== Functions ===");
    # XFAIL: call_with_args (Var+Var in add function)
    # XFAIL: nested_calls (uses add)
    # XFAIL: function_with_locals (uses add)
    @println(functions.call_private());
    @println(functions.test_recursion());
    @println(functions.test_fib());
    @println(functions.early_return());
    @println(functions.deep_recursion());

    @println("=== Lists ===");
