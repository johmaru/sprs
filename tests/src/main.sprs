    @println(comparison.shift_with_vars());
    @println(comparison.shift_in_expr());
    @println(comparison.rshift_signed_negative());
    @println(comparison.lshift_then_rshift());
    @println(comparison.shift_chain());
    @println(comparison.rshift_all_bits());
    @println("=== Not ===");
    @println(comparison.not_zero());
    @println(comparison.not_nonzero());
    @println(comparison.not_negative());
    @println(comparison.not_expr());
    @println(comparison.not_in_if());
    @println("=== Float ===");
    @println(types.float_add());
    @println(types.float_sub());
    @println(types.float_mul());
    @println(types.float_div());
    @println(types.float_complex());
    @println(types.float_var_arith());
    # XFAIL: @cast >> fp (infer_type bug)
    # @println(types.float_cast_f16());
    # @println(types.float_cast_f32());
    # @println(types.float_cast_f64());
    @println(types.float_while_loop());
    @println(types.float_nested());
    @println(types.float_mixed());
    @println("=== String ===");
