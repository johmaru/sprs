pkg errors;

# === Error Mechanism (labels) ===

# Test: @error creates an error label `{:error, reason}`
fn make_error() >> err {
    return @error("test error");
}

# Test: @is_error detects error labels
pub fn check_error() >> bool {
    var error_value = make_error();
    return @is_error(error_value);
}

# Test: @error_message extracts the reason
pub fn get_error_message() >> str {
    var error_value = make_error();
    return @error_message(error_value);
}

# Test: ? propagation — returns the error label without running the rest
pub fn propagate_error() >> err {
    var error_value = make_error()?;
    return error_value; # unreachable when error propagates
}

# Test: label reason (詳細表示: non-string payload renders via format_sprs_value)
pub fn label_reason_message() >> str {
    return @error_message(@error(:enoent));
}

# Test: short-circuit (error + 1 should preserve the error)
pub fn short_circuit_test() >> bool {
    var error_value = make_error();
    var calculated_value = error_value + 1;
    return @is_error(calculated_value);
}

# Test: div by zero returns catchable error label
pub fn div_zero_is_error() >> bool {
    var error_value = 5 / 0;
    return @is_error(error_value);
}

# Test: div by zero error message
pub fn div_zero_message() >> str {
    var error_value = 5 / 0;
    return @error_message(error_value);
}

# Test: mod by zero returns catchable error label
pub fn mod_zero_is_error() >> bool {
    var error_value = 5 % 0;
    return @is_error(error_value);
}

# Test: non-error is not an error
pub fn not_an_error() >> bool {
    var normal_value = 42;
    return @is_error(normal_value);
}
