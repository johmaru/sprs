pkg labels;

pub label :ready;
label Color { red, blue }
label :local_atom;


# Dynamic label name + payload
pub fn dynamic_payload() >> i64 {
    var item_index = 10;
    var labeled_value = {:"{item_index}-item", 42};
    if @label_is(labeled_value, :"{item_index}-item") {
        return @label_payload(labeled_value);
    }
    return 0;
}

pub fn dynamic_name() >> str {
    var item_index = 10;
    var labeled_value = {:"{item_index}-item", 42};
    return @label_name(labeled_value);
}

fn wrap(input_value >> i64) >> Label(:ok, i64) {
    return {:ok, input_value};
}

pub fn typed_label_payload() >> i64 {
    return @label_payload(wrap(7));
}

pub fn static_label_is() >> bool {
    var labeled_value = {:ok, 1};
    return @label_is(labeled_value, :ok);
}

pub fn atom_identity() >> bool {
    var same = :ok == :ok;
    var different = :ok == :error;
    if same {
        return @not(different);
    }
    return false;
}

pub fn attach_slot_roundtrip() >> i64 {
    @attach({:ok, 7}, <:item);
    return @label_payload(<:item);
}

pub fn slot_and_atom_display() {
    @attach({:ok, 7}, <:item);
    @println(<:item);
    @println(:item);
}

# --- match (v1: static patterns) ---

pub fn match_label_bind() >> i64 {
    match {:ok, 7} ?(var r) {
        case :ok => 1 break;
        case :error => 0 break;
    }
    return r;
}

pub fn match_payload_bind() >> i64 {
    match {:ok, 7} ?(var r) {
        case {:ok, x} => x break;
        case :error => 0 break;
    }
    return r;
}

pub fn match_atom_bind() >> i64 {
    match :ok ?(var r) {
        case :ok => 1 break;
        case :error => 0 break;
    }
    return r;
}

pub fn match_no_bind_block() >> i64 {
    var flag = 0;
    match :error {
        case :ok => {
            flag = 100;
        }
        case :error => {
            flag = 1;
        }
    }
    return flag;
}

pub fn match_expr_wildcard() >> i64 {
    var r = match :ok {
        case :ok => 1
        case :error => 0
        case _ => -1
    };
    return r;
}

pub fn match_expr_default() >> i64 {
    var r = match :unknown {
        case :ok => 1
        case :error => 0
        case _ => -1
    };
    return r;
}

pub fn match_expr_payload() >> i64 {
    var r = match {:ok, 7} {
        case {:ok, x} => x
        case _ => 0
    };
    return r;
}

pub fn match_expr_payload_str() >> str {
    var r = match {:ok, "hello"} {
        case {:ok, x} => x
        case _ => ""
    };
    return r;
}

pub fn match_expr_move_str() >> str {
    var s = "hello";
    var r = match :ok {
        case :ok => s
        case _ => "x"
    };
    return r;
}

pub fn match_expr_clone_str() >> str {
    var s = "hello";
    var r = match :ok {
        case :ok => @clone(s)
        case _ => "x"
    };
    # @clone keeps s usable in the arm; _keep then moves the original.
    var _keep = s;
    return r;
}

pub fn match_stmt_payload_str() >> str {
    match {:ok, "hello"} ?(var r) {
        case {:ok, x} => x break;
        case _ => "" break;
    }
    return r;
}

pub fn color_frame_identity() >> bool {
    var color = :Color.red;
    if color == :Color.red {
        if color != :red {
            return true;
        }
    }
    return false;
}

label Palette { red, green, blue }

pub fn palette_access() >> i64 {
    var c = :Palette.red;
    return 1;
}

pub fn palette_multiple() >> i64 {
    var a = :Palette.red;
    var b = :Palette.green;
    var c = :Palette.blue;
    return 3;
}

pub fn palette_in_list() >> i64 {
    var y = [];
    @list_push(y, :Palette.green);
    return 1;
}

pub fn palette_eq_same() >> bool {
    return :Palette.red == :Palette.red;
}

pub fn palette_eq_other() >> bool {
    return :Palette.red == :Palette.green;
}

pub fn palette_eq_bare_atom() >> bool {
    return :Palette.red == :red;
}

pub fn palette_match_red() >> i64 {
    var r = match :Palette.red {
        case :Palette.red => 1
        case :Palette.green => 2
        case :Palette.blue => 3
    };
    return r;
}

pub fn palette_print() {
    @println(:Palette.red);
}

fn local_atom_arg(value) >> bool {
    return value == :local_atom;
}

fn local_atom_return() {
    return local_atom;
}

pub fn local_atom_paths() >> bool {
    var initialized = local_atom;
    var returned = local_atom_return();
    var listed = [local_atom];
    var wrapped = {:wrapped, local_atom};
    if initialized == :local_atom {
        if returned == :local_atom {
            if local_atom_arg(local_atom) {
                if listed[0] == :local_atom {
                    if @label_payload(wrapped) == :local_atom {
                        return true;
                    }
                }
            }
        }
    }
    return false;
}

pub fn shadow_local_atom() >> i64 {
    var local_atom = 7;
    return local_atom;
}
