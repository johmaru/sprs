pkg labels;

# Dynamic label name + payload
pub fn dynamic_payload() >> int {
    var item_index = 10;
    var labeled_value = {:"{item_index}-item", 42};
    if @label_is(labeled_value, :"{item_index}-item") {
        return @label_payload(labeled_value);
    }
    return 0;
}

pub fn dynamic_name() >> str {
    var item_index = 10;
    var labeled_value = {:"{item_index}-item", 42};
    return @label_name(labeled_value);
}

fn wrap(input_value >> int) >> Label(:ok, int) {
    return {:ok, input_value};
}

pub fn typed_label_payload() >> int {
    return @label_payload(wrap(7));
}

pub fn static_label_is() >> bool {
    var labeled_value = {:ok, 1};
    return @label_is(labeled_value, :ok);
}

pub fn atom_identity() >> bool {
    var same = :ok == :ok;
    var different = :ok == :error;
    if same {
        return @not(different);
    }
    return false;
}

pub fn attach_slot_roundtrip() >> int {
    @attach({:ok, 7}, <:item);
    return @label_payload(<:item);
}

pub fn slot_and_atom_display() {
    @attach({:ok, 7}, <:item);
    @println(<:item);
    @println(:item);
}
