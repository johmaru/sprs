pkg labels;

# Dynamic label name + payload
pub fn dynamic_payload() >> int {
    var item_index = 10;
    var labeled_value = {:"{item_index}-item", 42};
    if @label_is(labeled_value, :"{item_index}-item") {
        return @label_payload(labeled_value);
    }
    return 0;
}

pub fn dynamic_name() >> str {
    var item_index = 10;
    var labeled_value = {:"{item_index}-item", 42};
    return @label_name(labeled_value);
}

fn wrap(input_value >> int) >> Label(:ok, int) {
    return {:ok, input_value};
}

pub fn typed_label_payload() >> int {
    return @label_payload(wrap(7));
}

pub fn static_label_is() >> bool {
    var labeled_value = {:ok, 1};
    return @label_is(labeled_value, :ok);
}

pub fn atom_identity() >> bool {
    var same = :ok == :ok;
    var different = :ok == :error;
    if same {
        return @not(different);
    }
    return false;
}

pub fn attach_slot_roundtrip() >> int {
    @attach({:ok, 7}, <:item);
    return @label_payload(<:item);
}

pub fn slot_and_atom_display() {
    @attach({:ok, 7}, <:item);
    @println(<:item);
    @println(:item);
}

# --- match (v1: static patterns) ---

pub fn match_label_bind() >> int {
    match {:ok, 7} ?(var r) {
        case :ok => 1 break;
        case :error => 0 break;
    }
    return r;
}

pub fn match_payload_bind() >> int {
    match {:ok, 7} ?(var r) {
        case {:ok, x} => x break;
        case :error => 0 break;
    }
    return r;
}

pub fn match_atom_bind() >> int {
    match :ok ?(var r) {
        case :ok => 1 break;
        case :error => 0 break;
    }
    return r;
}

pub fn match_no_bind_block() >> int {
    var flag = 0;
    match :error {
        case :ok => {
            flag = 100;
        }
        case :error => {
            flag = 1;
        }
    }
    return flag;
}

pub fn match_expr_wildcard() >> int {
    var r = match :ok {
        case :ok => 1
        case :error => 0
        case _ => -1
    };
    return r;
}

pub fn match_expr_default() >> int {
    var r = match :unknown {
        case :ok => 1
        case :error => 0
        case _ => -1
    };
    return r;
}

pub fn match_expr_payload() >> int {
    var r = match {:ok, 7} {
        case {:ok, x} => x
        case _ => 0
    };
    return r;
}

pub fn match_expr_payload_str() >> str {
    var r = match {:ok, "hello"} {
        case {:ok, x} => x
        case _ => ""
    };
    return r;
}

pub fn match_expr_move_str() >> str {
    var s = "hello";
    var r = match :ok {
        case :ok => s
        case _ => "x"
    };
    return r;
}

pub fn match_expr_clone_str() >> str {
    cp var s = "hello";
    var r = match :ok {
        case :ok => s
        case _ => "x"
    };
    # `cp` keeps s usable; dropping both must not double-free.
    var _keep = s;
    return r;
}

pub fn match_stmt_payload_str() >> str {
    match {:ok, "hello"} ?(var r) {
        case {:ok, x} => x break;
        case _ => "" break;
    }
    return r;
}
