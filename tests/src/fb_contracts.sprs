pkg fb_contracts;

struct Job {
    id >> i64
}

pub function_build AddBuild {
    params(lhs >> i64, rhs >> i64);
    return_type(i64);
    visibility(pub);
}

pub function_build JobFn {
    params(job >> Job);
    return_type(i64);
    visibility(pub);
}

function_build InternalBuild {
    return_type(str);
}

fn helper_not_imported() {
}
