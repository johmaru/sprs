pkg fn_builds;

function_build source fb_contracts;

struct Point {
    x >> i64
}

function_build PointFn {
    params(point >> Point);
    return_type(i64);
    visibility(pub);
}

function_build Empty {}

fn forward use LaterBuild {
    return 7;
}

function_build LaterBuild {
    return_type(i64);
    visibility(pub);
}

function_build UnaryI64 {
    params(value >> i64);
    return_type(i64);
    visibility(pub);
}

function_build Identity {
    type_param T;
    params(value >> T);
    return_type(T);
    visibility(pub);
}

fn fb_add use AddBuild {
    return lhs + rhs;
}

fn echo_a use UnaryI64 {
    return value;
}

fn echo_b use UnaryI64 {
    return value;
}

fn forward_value use LaterBuild {
    return forward();
}

fn empty_ok use Empty {
}

fn point_x use PointFn {
    return point.x;
}

fn job_id use JobFn {
    return job.id;
}

fn identity_i64 use Identity {
    return value;
}

fn identity_str use Identity {
    return value;
}
