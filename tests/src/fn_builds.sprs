pkg fn_builds;

function_build source fb_contracts;

struct Point {
    x >> i64
}

function_build PointFn {
    params(point >> Point);
    return_type(i64);
    visibility(pub);
}

function_build Empty {}

fn forward use LaterBuild {
    return 7;
}

function_build LaterBuild {
    return_type(i64);
    visibility(pub);
}

function_build UnaryI64 {
    params(value >> i64);
    return_type(i64);
    visibility(pub);
}

function_build Identity {
    type_param T;
    params(value >> T);
    return_type(T);
    visibility(pub);
}

fn fb_add use AddBuild {
    return lhs + rhs;
}

fn echo_a use UnaryI64 {
    return value;
}

fn echo_b use UnaryI64 {
    return value;
}

fn forward_value use LaterBuild {
    return forward();
}

fn empty_ok use Empty {
}

fn point_x use PointFn {
    return point.x;
}

fn job_id use JobFn {
    return job.id;
}

fn identity use Identity {
    return value;
}

pub fn same<T>(left >> T, right >> T) >> T {
    return left;
}

pub struct MethodBox(T) {
    value >> T,
    pub fn get(self) >> T {
        return self.value;
    }
}

pub fn method_box_i64() >> i64 {
    var box = init MethodBox(i64) { value = 42 };
    return box.get();
}

pub fn method_box_str() >> str {
    var box = init MethodBox(str) { value = "owned" };
    return box.get();
}

pub fn method_box_nested() >> i64 {
    var inner = init MethodBox(i64) { value = 7 };
    var outer = init MethodBox(MethodBox(i64)) { value = inner };
    return outer.get().get();
}

pub fn rec_generic<T>(n >> i64, value >> T) >> T {
    if n == 0 {
        return value;
    }
    return rec_generic(n - 1, value);
}

pub fn rec_generic_done() >> i64 {
    return rec_generic(2, 9);
}
